# --- Security (REQUIRED in production) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./fxanalysis.db
# PostgreSQL:
# DATABASE_URL=******localhost:5432/fxanalysis

# --- Trade history source (all options are 100% free) ---
# "manual" = upload an MT5 statement export (.html / .xlsx). Works on any OS, no password.
# "mt5"    = native MetaTrader5 Python package. Free, but Windows-only and needs the
#            MT5 terminal installed on the same machine as this backend.
# "demo"   = built-in generated sample history for exploring the app.
MT5_PROVIDER=manual

# Max statement upload size in bytes (default 20 MB).
MAX_UPLOAD_BYTES=20971520

# --- Behaviour ---
# Chart candles are fetched from Yahoo Finance - free, no API key, no signup.
SYNC_INTERVAL_MINUTES=15
CANDLE_CACHE_TTL_SECONDS=300
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
