f_trimLabels(array<label> pool, int limit) =>
    while pool.size() > limit
        pool.shift().delete()
    true

f_clearLabels(array<label> pool) => f_trimLabels(pool, 0)

f_clearLines(array<line> pool) =>
    while pool.size() > 0
        pool.shift().delete()
    true

type ZZ
    array<int> d
    array<int> x
    array<float> y
    array<line> l

type Ewave
    line   l1
    line   l2
    line   l3
    line   l4
    line   l5
    label  b1
    label  b2
    label  b3
    label  b4
    label  b5
    //
    bool   on
    bool   br //= na
    //
    int    dir
    //
    line   lA
    line   lB
    line   lC
    label  bA
    label  bB
    label  bC
    //
    bool next = false
    //
    label  lb
    box    bx

type fibL
    line wave1_0_500
    line wave1_0_618
    line wave1_0_764
    line wave1_0_854
    line wave1_pole_
    linefill l_fill_
    bool     _break_ //= na

float hi = ewSrcHigh == "high" ? high : ewSrcHigh == "close" ? close : math.max(open, close)
float lo = ewSrcLow == "low" ? low : ewSrcLow == "close" ? close : math.min(open, close)

in_out(aZZ, d, x1, y1, x2, y2, col) =>
    aZZ.d.unshift(d), aZZ.x.unshift(x2), aZZ.y.unshift(y2), aZZ.d.pop(), aZZ.x.pop(), aZZ.y.pop()
    if ewShowZz
        aZZ.l.unshift(line.new(x1, y1, x2, y2, color= col, force_overlay = true)), aZZ.l.pop().delete()

method isSame(Ewave gEW, _1x, _2x, _3x, _4x) =>
    t1 = _1x == gEW.l1.get_x1()
    t2 = _2x == gEW.l2.get_x1()
    t3 = _3x == gEW.l3.get_x1()
    t4 = _4x == gEW.l4.get_x1()
    t1 and t2 and t3 and t4

method isSame2(Ewave gEW, _1x, _2x, _3x) =>
    t1 = _1x == gEW.l3.get_x2()
    t2 = _2x == gEW.l4.get_x2()
    t3 = _3x == gEW.l5.get_x2()
    t1 and t2 and t3

method makeDotted(Ewave gEW) =>
    gEW.l1.set_style(line.style_dotted)
    gEW.l2.set_style(line.style_dotted)
    gEW.l3.set_style(line.style_dotted)
    gEW.l4.set_style(line.style_dotted)
    gEW.l5.set_style(line.style_dotted)
    gEW.b1.set_textcolor    (color(na))
    gEW.b2.set_textcolor    (color(na))
    gEW.b3.set_textcolor    (color(na))
    gEW.b4.set_textcolor    (color(na))
    gEW.b5.set_textcolor    (color(na))
    gEW.on := false

method makeDashed(Ewave gEW) =>
    gEW.lA.set_style(line.style_dashed)
    gEW.lB.set_style(line.style_dashed)
    gEW.lC.set_style(line.style_dashed)
    gEW.bA.set_textcolor    (color(na))
    gEW.bB.set_textcolor    (color(na))
    gEW.bC.set_textcolor    (color(na))
    gEW.bx.set_bgcolor      (color(na))
    gEW.bx.set_border_color (color(na))

method sol_dot(fibL nFibL, sol_dot, col) =>
    style =
     sol_dot ==  'dot'  ?
      line.style_dotted :
     sol_dot ==  'sol'  ?
      line.style_solid  :
      line.style_dashed
    nFibL.wave1_0_500.set_style(style)
    nFibL.wave1_0_618.set_style(style)
    nFibL.wave1_0_764.set_style(style)
    nFibL.wave1_0_854.set_style(style)
    nFibL.l_fill_.set_color(col)

method setLevels(fibL nFibL, int x1, int x2, float max_500, float max_618, float max_764, float max_854, float y2) =>
    nFibL.wave1_0_500.set_xy1(x1, max_500)
    nFibL.wave1_0_500.set_xy2(x2, max_500)
    nFibL.wave1_0_618.set_xy1(x1, max_618)
    nFibL.wave1_0_618.set_xy2(x2, max_618)
    nFibL.wave1_0_764.set_xy1(x1, max_764)
    nFibL.wave1_0_764.set_xy2(x2, max_764)
    nFibL.wave1_0_854.set_xy1(x1, max_854)
    nFibL.wave1_0_854.set_xy2(x2, max_854)
    nFibL.wave1_pole_.set_xy1(x1,     y2 )
    nFibL.wave1_pole_.set_xy2(x1, max_854)
    nFibL.l_fill_.get_line1().set_xy1(x1, max_764)
    nFibL.l_fill_.get_line1().set_xy2(x2, max_764)
    nFibL.l_fill_.get_line2().set_xy1(x1, max_854)
    nFibL.l_fill_.get_line2().set_xy2(x2, max_854)

method clearLevels(fibL nFibL) =>
    nFibL.wave1_0_500.set_xy1(na, na)
    nFibL.wave1_0_500.set_xy2(na, na)
    nFibL.wave1_0_618.set_xy1(na, na)
    nFibL.wave1_0_618.set_xy2(na, na)
    nFibL.wave1_0_764.set_xy1(na, na)
    nFibL.wave1_0_764.set_xy2(na, na)
    nFibL.wave1_0_854.set_xy1(na, na)
    nFibL.wave1_0_854.set_xy2(na, na)
    nFibL.wave1_pole_.set_xy1(na, na)
    nFibL.wave1_pole_.set_xy2(na, na)
    nFibL.l_fill_.set_color(color(na))

f_ewZigzag(bool enabled, int left, color col, int n) =>
    //
    var int dir = na
    var int x1 = na
    var float y1 = na
    var int x2 = na
    var float y2 = na
    var Ewave gEW = na
    var int last_0x = na
    var float last_0y = na
    var int last_6x = na
    var float last_6y = na
    //
    float ph = ta.pivothigh(hi, left, 1)
    float pl = ta.pivotlow(lo, left, 1)
    if enabled
        var fibL nFibL = fibL.new(
           wave1_0_500 = line.new(na, na, na, na, color= color.new(col, 50), style= line.style_solid , force_overlay = true),
           wave1_0_618 = line.new(na, na, na, na, color= color.new(col, 38), style= line.style_solid , force_overlay = true),
           wave1_0_764 = line.new(na, na, na, na, color= color.new(col, 24), style= line.style_solid , force_overlay = true),
           wave1_0_854 = line.new(na, na, na, na, color= color.new(col, 15), style= line.style_solid , force_overlay = true),
           wave1_pole_ = line.new(na, na, na, na, color= color.new(col, 50), style= line.style_dashed, force_overlay = true),
               l_fill_ = linefill.new(
                         line.new(na, na, na, na, color= color(na), force_overlay = true)
                       , line.new(na, na, na, na, color= color(na), force_overlay = true)
                       ,                          color= color(na))
                       ,                         _break_   =   false
               )
        //
        var  ZZ        aZZ   =   ZZ.new(array.new < int   > ()
                                      , array.new < int   > ()
                                      , array.new < float > ()
                                      , array.new < line  > () )
        var array<Ewave> aEW = array.new<Ewave>()
        //
        if barstate.isfirst
            aEW.unshift(Ewave.new())
            for i = 0 to 10
                aZZ.d.unshift(0)
                aZZ.x.unshift(0)
                aZZ.y.unshift(0)
                aZZ.l.unshift(ewShowZz ? line.new(na, na, na, na, force_overlay = true) : na)
        //
        sz       = aZZ.d.size( )
        x2      := bar_index -1
        t        = n == 2 ? '\n\n' : n == 1 ? '\n' : ''
        //
        // when a new Pivot High is found
        if not na(ph)
            gEW := aEW.get   (0)
            dir := aZZ.d.get (0)
            x1  := aZZ.x.get (0)
            y1  := aZZ.y.get (0)
            y2  :=      nz(hi[1])
            //
            if dir <  1  // if previous point was a pl, add, and change direction ( 1)
                in_out(aZZ,  1, x1, y1, x2, y2, col)
            else
                if dir ==  1 and ph > y1
                    aZZ.x.set(0, x2), aZZ.y.set(0, y2)
                    if ewShowZz
                        aZZ.l.get(0).set_xy2(x2, y2)
            //
            _6x = x2, _6y = y2
            _5x = aZZ.x.get(1), _5y = aZZ.y.get(1)
            _4x = aZZ.x.get(2), _4y = aZZ.y.get(2)
            _3x = aZZ.x.get(3), _3y = aZZ.y.get(3)
            _2x = aZZ.x.get(4), _2y = aZZ.y.get(4)
            _1x = aZZ.x.get(5), _1y = aZZ.y.get(5)
            //
            // –––––––––––––––––––––[ 12345 ]–––––––––––––––––––––
            _W5 = _6y - _5y
            _W3 = _4y - _3y
            _W1 = _2y - _1y
            min = math.min(_W1, _W3, _W5)
            isWave =
             _W3 != min and
             _6y  > _4y and
             _3y  > _1y and
             _5y  > _2y
            //
            same = gEW.isSame(_1x, _2x, _3x, _4x)
            if isWave
                if same
                    gEW.l5.set_xy2(_6x, _6y)
                    gEW.b5.set_xy (_6x, _6y)
                else
                    tx = ''
                    if _2x == aEW.get(0).b5.get_x()
                        tx := '(5) (1)'
                        aEW.get(0).b5.set_text('')
                    else
                        tx := '(1)'
                    //
                    wave = Ewave.new(
                     l1  = line.new (_1x, _1y, _2x, _2y                      , color=col       , style= line.style_solid     , force_overlay = true),
                     l2  = line.new (_2x, _2y, _3x, _3y                      , color=col       , style= line.style_solid     , force_overlay = true),
                     l3  = line.new (_3x, _3y, _4x, _4y                      , color=col       , style= line.style_solid     , force_overlay = true),
                     l4  = line.new (_4x, _4y, _5x, _5y                      , color=col       , style= line.style_solid     , force_overlay = true),
                     l5  = line.new (_5x, _5y, _6x, _6y                      , color=col       , style= line.style_solid     , force_overlay = true),
                     b1  = label.new(_2x, _2y, text= tx    + t, textcolor=col, color= color(na), style=label.style_label_down, force_overlay = true),
                     b2  = label.new(_3x, _3y, text= t + '(2)', textcolor=col, color= color(na), style=label.style_label_up  , force_overlay = true),
                     b3  = label.new(_4x, _4y, text= '(3)' + t, textcolor=col, color= color(na), style=label.style_label_down, force_overlay = true),
                     b4  = label.new(_5x, _5y, text= t + '(4)', textcolor=col, color= color(na), style=label.style_label_up  , force_overlay = true),
                     b5  = label.new(_6x, _6y, text= '(5)' + t, textcolor=col, color= color(na), style=label.style_label_down, force_overlay = true),
                     on  = true                                                                                               ,
                     br  = false                                                                                              ,
                     dir = 1
                      )
                    aEW.unshift(wave)
                    nFibL._break_ := false
                    alert('New EW Motive Bullish Pattern found'  , alert.freq_once_per_bar_close)
            //
            if not isWave
                if same and gEW.on == true
                    gEW.makeDotted()
                    alert('Invalidated EW Motive Bullish Pattern', alert.freq_once_per_bar_close)
            //
            // –––––––––––––––––––––[ ABC ]–––––––––––––––––––––
            getEW    = aEW.get(0)
            last_0x := getEW.l1.get_x1(), last_0y := getEW.l1.get_y1()
            last_6x := getEW.l5.get_x2(), last_6y := getEW.l5.get_y2()
            diff     = math.abs(last_6y - last_0y)
            //
            if getEW.dir == -1
                getX    = getEW.l5.get_x2()
                getY    = getEW.l5.get_y2()
                isSame2 = getEW.isSame2  (_1x, _2x, _3x)
                isValid =
                   _3x == getX                  and
                   _6y  < getY + (diff * ewFib4) and
                   _4y  < getY + (diff * ewFib4) and
                   _5y  > getY
                //
                if isValid
                    width = _6x - _2x // –––[ width (4) - (c) ]–––
                    if isSame2 and getEW.bA.get_x() > _3x
                        getEW.lC.set_xy1(_5x, _5y), getEW.lC.set_xy2(_6x, _6y), getEW.bC.set_xy(_6x, _6y), getEW.bx.set_lefttop(_6x, _6y), getEW.bx.set_right(_6x + width)
                    else
                        getEW.lA := line.new (_3x, _3y, _4x, _4y, color=col, force_overlay = true), getEW.bA := label.new(_4x, _4y, text= '(a)' + t, textcolor=col, color= color(na), style=label.style_label_down, force_overlay = true)
                        getEW.lB := line.new (_4x, _4y, _5x, _5y, color=col, force_overlay = true), getEW.bB := label.new(_5x, _5y, text= t + '(b)', textcolor=col, color= color(na), style=label.style_label_up  , force_overlay = true)
                        getEW.lC := line.new (_5x, _5y, _6x, _6y, color=col, force_overlay = true), getEW.bC := label.new(_6x, _6y, text= '(c)' + t, textcolor=col, color= color(na), style=label.style_label_down, force_overlay = true)
                        getEW.bx := box.new  (_6x, _6y, _6x + width, _4y, bgcolor=color.new(col, 93), border_color=color.new(col, 65), force_overlay = true)
                        alert('New EW Corrective Bullish Pattern found'  , alert.freq_once_per_bar_close)
                else
                    if isSame2 and getEW.bA.get_x() > _3x
                        getEW.makeDashed()
                        alert('Invalidated EW Corrective Bullish Pattern', alert.freq_once_per_bar_close)
            //
            // –––––––––––––––––––––[ new (1) ? ]–––––––––––––––––––––
            if getEW.dir ==  1
                if _5x == getEW.bC.get_x() and
                   _6y >  getEW.b5.get_y() and
                   getEW.next  == false
                    getEW.next := true
                    getEW.lb   := label.new(_6x, _6y, style=label.style_circle, color=color.new(col, 65), yloc=yloc.abovebar, size=size.tiny, force_overlay = true)
                    alert('Possible new start of EW Motive Bullish Wave', alert.freq_once_per_bar_close)
        //
        // when a new Pivot Low is found
        if not na(pl)
            gEW := aEW.get   (0)
            dir := aZZ.d.get (0)
            x1  := aZZ.x.get (0)
            y1  := aZZ.y.get (0)
            y2  :=      nz(lo[1])
            //
            if dir > -1  // if previous point was a ph, add, and change direction (-1)
                in_out(aZZ, -1, x1, y1, x2, y2, col)
            else
                if dir == -1 and pl < y1
                    aZZ.x.set(0, x2), aZZ.y.set(0, y2)
                    if ewShowZz
                        aZZ.l.get(0).set_xy2(x2, y2)
            //
            _6x = x2, _6y = y2
            _5x = aZZ.x.get(1), _5y = aZZ.y.get(1)
            _4x = aZZ.x.get(2), _4y = aZZ.y.get(2)
            _3x = aZZ.x.get(3), _3y = aZZ.y.get(3)
            _2x = aZZ.x.get(4), _2y = aZZ.y.get(4)
            _1x = aZZ.x.get(5), _1y = aZZ.y.get(5)
            //
            // –––––––––––––––––––––[ 12345 ]–––––––––––––––––––––
            _W5 = _5y - _6y
            _W3 = _3y - _4y
            _W1 = _1y - _2y
            min = math.min(_W1, _W3, _W5)
            isWave =
             _W3 != min and
             _4y  > _6y and
             _1y  > _3y and
             _2y  > _5y
            //
            same = isSame(gEW, _1x, _2x, _3x, _4x)
            if isWave
                if same
                    gEW.l5.set_xy2(_6x, _6y)
                    gEW.b5.set_xy (_6x, _6y)
                else
                    tx = ''
                    if _2x == aEW.get(0).b5.get_x()
                        tx := '(5) (1)'
                        aEW.get(0).b5.set_text('')
                    else
                        tx := '(1)'
                    //
                    wave = Ewave.new(
                     l1  = line.new (_1x, _1y, _2x, _2y                      , color=col       , style= line.style_solid     , force_overlay = true),
                     l2  = line.new (_2x, _2y, _3x, _3y                      , color=col       , style= line.style_solid     , force_overlay = true),
                     l3  = line.new (_3x, _3y, _4x, _4y                      , color=col       , style= line.style_solid     , force_overlay = true),
                     l4  = line.new (_4x, _4y, _5x, _5y                      , color=col       , style= line.style_solid     , force_overlay = true),
                     l5  = line.new (_5x, _5y, _6x, _6y                      , color=col       , style= line.style_solid     , force_overlay = true),
                     b1  = label.new(_2x, _2y, text= t    + tx, textcolor=col, color= color(na), style=label.style_label_up  , force_overlay = true),
                     b2  = label.new(_3x, _3y, text= '(2)' + t, textcolor=col, color= color(na), style=label.style_label_down, force_overlay = true),
                     b3  = label.new(_4x, _4y, text= t + '(3)', textcolor=col, color= color(na), style=label.style_label_up  , force_overlay = true),
                     b4  = label.new(_5x, _5y, text= '(4)' + t, textcolor=col, color= color(na), style=label.style_label_down, force_overlay = true),
                     b5  = label.new(_6x, _6y, text= t + '(5)', textcolor=col, color= color(na), style=label.style_label_up  , force_overlay = true),
                     on  = true                                                                                               ,
                     br  = false                                                                                              ,
                     dir =-1
                      )
                    aEW.unshift(wave)
                    nFibL._break_ := false
                    alert('New EW Motive Bearish Pattern found'  , alert.freq_once_per_bar_close)
            //
            if not isWave
                if same and gEW.on == true
                    gEW.makeDotted()
                    alert('Invalidated EW Motive Bearish Pattern', alert.freq_once_per_bar_close)
            //
            // –––––––––––––––––––––[ ABC ]–––––––––––––––––––––
            getEW    = aEW.get(0)
            last_0x := getEW.l1.get_x1(), last_0y := getEW.l1.get_y1()
            last_6x := getEW.l5.get_x2(), last_6y := getEW.l5.get_y2()
            diff     = math.abs(last_6y - last_0y)
            //
            if getEW.dir ==  1
                getX    = getEW.l5.get_x2()
                getY    = getEW.l5.get_y2()
                isSame2 = getEW.isSame2  (_1x, _2x, _3x)
                isValid =
                   _3x == getX                  and
                   _6y  > getY - (diff * ewFib4) and
                   _4y  > getY - (diff * ewFib4) and
                   _5y  < getY
                //
                if isValid
                    width = _6x - _2x // –––[ width (4) - (c) ]–––
                    if isSame2 and getEW.bA.get_x() > _3x
                        getEW.lC.set_xy1(_5x, _5y), getEW.lC.set_xy2(_6x, _6y), getEW.bC.set_xy(_6x, _6y), getEW.bx.set_lefttop(_6x, _6y), getEW.bx.set_right(_6x + width)
                    else
                        getEW.lA := line.new (_3x, _3y, _4x, _4y, color=col, force_overlay = true), getEW.bA := label.new(_4x, _4y, text= t + '(a)', textcolor=col, color= color(na), style=label.style_label_up  , force_overlay = true)
                        getEW.lB := line.new (_4x, _4y, _5x, _5y, color=col, force_overlay = true), getEW.bB := label.new(_5x, _5y, text= '(b)' + t, textcolor=col, color= color(na), style=label.style_label_down, force_overlay = true)
                        getEW.lC := line.new (_5x, _5y, _6x, _6y, color=col, force_overlay = true), getEW.bC := label.new(_6x, _6y, text= t + '(c)', textcolor=col, color= color(na), style=label.style_label_up  , force_overlay = true)
                        getEW.bx := box.new  (_6x, _6y, _6x + width, _4y, bgcolor=color.new(col, 93), border_color=color.new(col, 65), force_overlay = true)
                        alert('New EW Corrective Bearish Pattern found'  , alert.freq_once_per_bar_close)
                else
                    if isSame2 and getEW.bA.get_x() > _3x
                        getEW.makeDashed()
                        alert('Invalidated EW Corrective Bullish Pattern', alert.freq_once_per_bar_close)
            //
            // –––[ check (only once) for a possible new (1) after an impulsive AND corrective wave ]–––
            if getEW.dir == -1
                if _5x == getEW.bC.get_x() and
                   _6y <  getEW.b5.get_y() and
                   getEW.next  == false
                    getEW.next := true
                    getEW.lb   := label.new(_6x, _6y, style=label.style_circle, color=color.new(col, 65), yloc=yloc.belowbar, size=size.tiny, force_overlay = true)
                    alert('Possible new start of EW Motive Bearish Wave', alert.freq_once_per_bar_close)
        //
        // –––[ check for break box ]–––
        if aEW.size() > 0
            gEW    := aEW.get(0)
            if gEW.dir == 1
                if ta.crossunder(low , gEW.bx.get_bottom()) and bar_index <= gEW.bx.get_right()
                    label.new(bar_index, low , yloc= yloc.belowbar, style= label.style_xcross, color=color.red, size=size.tiny, force_overlay = true)
            else
                if ta.crossover (high, gEW.bx.get_top   ()) and bar_index <= gEW.bx.get_right()
                    label.new(bar_index, high, yloc= yloc.abovebar, style= label.style_xcross, color=color.red, size=size.tiny, force_overlay = true)
        //
        if barstate.islast
            //  –––[ get last 2 EW's ]–––
            getEW    = aEW.get(0)
            if aEW.size() > 1
                getEW1   = aEW.get(1)
                last_0x := getEW.l1.get_x1(), last_0y := getEW.l1.get_y1()
                last_6x := getEW.l5.get_x2(), last_6y := getEW.l5.get_y2()
                //
                diff = math.abs(last_6y - last_0y) // –––[ max/min difference ]–––
                _500 = diff * ewFib1
                _618 = diff * ewFib2
                _764 = diff * ewFib3
                _854 = diff * ewFib4
                bull = getEW.dir == 1
                // –––[ if EW is not valid or an ABC has developed -> remove fibonacci lines ]–––
                if getEW.on == false or getEW.bC.get_x() > getEW.b5.get_x()
                    nFibL.clearLevels()
                else
                // –––[ get.on == true ~ valid EW ]–––
                    max_500 = last_6y + ((bull ? -1 : 1) * _500)
                    max_618 = last_6y + ((bull ? -1 : 1) * _618)
                    max_764 = last_6y + ((bull ? -1 : 1) * _764)
                    max_854 = last_6y + ((bull ? -1 : 1) * _854)
                    //
                    nFibL.setLevels(last_6x, bar_index + 10, max_500, max_618, max_764, max_854, last_6y)
                // –––[ if (2) label overlap with (C) label ]–––
                if  getEW.b2.get_x() == getEW1.bC.get_x()
                    getEW.b1.set_textcolor(color(na))
                    getEW.b2.set_textcolor(color(na))
                    strB  = getEW1.bB.get_text()
                    strC  = getEW1.bC.get_text()
                    strB_ = str.replace(strB, "(b)",  "(b) (1)", 0)
                    strC_ = str.replace(strC, "(c)",  "(c) (2)", 0)
                    getEW1.bB.set_text(strB_)
                    getEW1.bC.set_text(strC_)
            //
            // –––[ check if fib limits are broken ]–––
            float getP_854 = nFibL.wave1_0_854.get_y1()
            int fibX = nFibL.wave1_0_854.get_x1()
            for i = 0 to (na(fibX) ? 0 : math.max(bar_index - fibX, 0))
                if getEW.dir == -1
                    if high[i] > getP_854
                        nFibL._break_ := true
                        break
                else
                    if low [i] < getP_854
                        nFibL._break_ := true
                        break
            //––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
            if nFibL._break_
                nFibL.sol_dot('dot', color.new(color.red, 95))
            else
                nFibL.sol_dot('sol', color.new(color.lime, 95))

        if aEW.size() > ewMaxWaves
            pop = aEW.pop()
            pop.l1.delete(), pop.b1.delete()
            pop.l2.delete(), pop.b2.delete()
            pop.l3.delete(), pop.b3.delete()
            pop.l4.delete(), pop.b4.delete()
            pop.l5.delete(), pop.b5.delete()
            pop.lA.delete(), pop.bA.delete()
            pop.lB.delete(), pop.bB.delete()
            pop.lC.delete(), pop.bC.delete()
            pop.lb.delete(), pop.bx.delete()
        //----------------------------------


f_ewZigzag(ewEnabled and ewOn1, ewLen1, ewCol1, 0)
f_ewZigzag(ewEnabled and ewOn2, ewLen2, ewCol2, 1)
f_ewZigzag(ewEnabled and ewOn3, ewLen3, ewCol3, 2)

var array<box> sdBoxes = array.new<box>()
var array<int> sdDirs = array.new<int>()
var array<float> sdTops = array.new<float>()
var array<float> sdBottoms = array.new<float>()
var array<int> sdTests = array.new<int>()
float sdAtr = ta.atr(atrLen)
float sdLimit = sdBaseAtr * sdAtr
bool sdSmall1 = math.abs(close[1] - open[1]) <= sdLimit
bool sdSmall2 = sdSmall1 and math.abs(close[2] - open[2]) <= sdLimit
bool sdSmall3 = sdSmall2 and math.abs(close[3] - open[3]) <= sdLimit
int sdBase = sdSmall3 and sdMaxBase >= 3 ? 3 : sdSmall2 and sdMaxBase >= 2 ? 2 : sdSmall1 ? 1 : 0
float sdBaseHigh = sdBase == 3 ? math.max(high[1], high[2], high[3]) : sdBase == 2 ? math.max(high[1], high[2]) : high[1]
float sdBaseLow = sdBase == 3 ? math.min(low[1], low[2], low[3]) : sdBase == 2 ? math.min(low[1], low[2]) : low[1]
float sdBodyHigh = sdBase == 3 ? math.max(math.max(open[1], close[1]), math.max(open[2], close[2]), math.max(open[3], close[3])) : sdBase == 2 ? math.max(math.max(open[1], close[1]), math.max(open[2], close[2])) : math.max(open[1], close[1])
float sdBodyLow = sdBase == 3 ? math.min(math.min(open[1], close[1]), math.min(open[2], close[2]), math.min(open[3], close[3])) : sdBase == 2 ? math.min(math.min(open[1], close[1]), math.min(open[2], close[2])) : math.min(open[1], close[1])
if sdEnabled and barstate.isconfirmed
    int total = array.size(sdBoxes)
    if total > 0
        for i = total - 1 to 0
            int dir = array.get(sdDirs, i)
            float top = array.get(sdTops, i)
            float bottom = array.get(sdBottoms, i)
            bool broken = dir == 1 ? close < bottom : close > top
            if broken
                box.delete(array.get(sdBoxes, i))
                array.remove(sdBoxes, i)
                array.remove(sdDirs, i)
                array.remove(sdTops, i)
                array.remove(sdBottoms, i)
                array.remove(sdTests, i)
            else if (dir == 1 and low <= top) or (dir == -1 and high >= bottom)
                array.set(sdTests, i, array.get(sdTests, i) + 1)
                if sdText
                    box.set_text(array.get(sdBoxes, i), (dir == 1 ? "D" : "S") + " x" + str.tostring(array.get(sdTests, i)))
    // Creation runs after mitigation, so the displacement candle cannot test its own new zone.
    float body = math.abs(close - open)
    int newDir = sdBase > 0 and not na(sdAtr) and body >= sdImpulseAtr * sdAtr ? (close > open and close > sdBaseHigh and sdDemand ? 1 : close < open and close < sdBaseLow and sdSupply ? -1 : 0) : 0
    if newDir != 0
        float zoneTop = newDir == 1 ? sdBodyHigh : (sdWicks ? sdBaseHigh : sdBodyHigh)
        float zoneBottom = newDir == 1 ? (sdWicks ? sdBaseLow : sdBodyLow) : sdBodyLow
        bool overlaps = false
        int zoneCount = array.size(sdBoxes)
        // Pine loops count downward when the end is below the start, so guard empty arrays.
        if zoneCount > 0
            for i = 0 to zoneCount - 1
                if array.get(sdDirs, i) == newDir and zoneTop >= array.get(sdBottoms, i) and zoneBottom <= array.get(sdTops, i)
                    overlaps := true
        if not overlaps and zoneTop > zoneBottom
            color zoneColor = newDir == 1 ? cBull : cBear
            array.push(sdBoxes, box.new(bar_index - sdBase, zoneTop, bar_index, zoneBottom, border_color = zoneColor, bgcolor = color.new(zoneColor, zoneOpacity), extend = extend.right, text = sdText ? (newDir == 1 ? "D" : "S") : "", text_color = color.white, text_size = size.tiny, text_halign = text.align_right, force_overlay = true))
            array.push(sdDirs, newDir)
            array.push(sdTops, zoneTop)
            array.push(sdBottoms, zoneBottom)
            array.push(sdTests, 0)
            if array.size(sdBoxes) > sdMaxZones
                box.delete(array.shift(sdBoxes))
                array.shift(sdDirs)
                array.shift(sdTops)
                array.shift(sdBottoms)
                array.shift(sdTests)

// Liquidity sweeps: adapted from "Liquidity Sweeps [LuxAlgo]" (CC BY-NC-SA 4.0, https://creativecommons.org/licenses/by-nc-sa/4.0/).
type LsPivot
    float prc
    int bix
    bool brk
    bool mit
    bool tak
    bool wic
    line lin

type LsArea
    box bx
    line ln
    bool done
    int dir

var array<LsPivot> lsHighs = array.new<LsPivot>()
var array<LsPivot> lsLows = array.new<LsPivot>()
var array<LsArea> lsAreas = array.new<LsArea>()

f_lsLevel(LsPivot pv, color c, string styleName) =>
    string st = styleName == "dotted" ? line.style_dotted : line.style_dashed
    line.new(pv.bix, pv.prc, bar_index, pv.prc, color = c, style = st, force_overlay = true)

f_lsArea(LsPivot pv, color fill, color edge, int dir) =>
    float y1 = dir == 1 ? high : pv.prc
    float y2 = dir == 1 ? pv.prc : low
    LsArea area = LsArea.new(box.new(bar_index - 1, y1, bar_index + 1, y2, border_color = na, bgcolor = fill, force_overlay = true), line.new(bar_index, y1, bar_index, y2, color = edge, width = 3, force_overlay = true), false, dir)
    array.unshift(lsAreas, area)
    if array.size(lsAreas) > lsMaxAreas
        LsArea old = array.pop(lsAreas)
        box.delete(old.bx)
        line.delete(old.ln)
    true

f_lsDot(float y, color c) =>
    line.new(bar_index, y, bar_index + 3, y, color = c, style = line.style_dotted, force_overlay = true)

float lsPh = ta.pivothigh(high, lsLen, lsLen)
float lsPl = ta.pivotlow(low, lsLen, lsLen)
bool lsOnlyWicks = lsMode == "Only Wicks"
bool lsOnlyRetest = lsMode == "Only Outbreaks & Retest"
color lsBullFill = color.new(cBull, 75)
color lsBearFill = color.new(cBear, 75)
color lsBullLine = color.new(cBull, 50)
color lsBearLine = color.new(cBear, 50)

if lsEnabled
    if not na(lsPh)
        array.unshift(lsHighs, LsPivot.new(lsPh, bar_index - lsLen, false, false, false, false, na))
    if not na(lsPl)
        array.unshift(lsLows, LsPivot.new(lsPl, bar_index - lsLen, false, false, false, false, na))

    int hiCount = array.size(lsHighs)
    if hiCount > 0
        for i = hiCount - 1 to 0
            LsPivot pv = array.get(lsHighs, i)
            if not pv.mit
                if not pv.brk
                    if close > pv.prc
                        if not lsOnlyWicks
                            pv.brk := true
                        else
                            pv.mit := true
                    if not lsOnlyRetest and not pv.wic and high > pv.prc and close < pv.prc
                        f_lsArea(pv, lsBearFill, cBear, 1)
                        f_lsLevel(pv, lsBearLine, "dotted")
                        f_lsDot(low, cBear)
                        pv.wic := true
                else
                    if close < pv.prc
                        pv.mit := true
                    if not lsOnlyWicks and low < pv.prc and close > pv.prc
                        f_lsArea(pv, lsBullFill, cBull, -1)
                        f_lsLevel(pv, lsBullLine, "dashed")
                        f_lsDot(high, cBull)
                        pv.tak := true
            if bar_index - pv.bix > 2000 or pv.mit or pv.tak
                array.remove(lsHighs, i)

    int loCount = array.size(lsLows)
    if loCount > 0
        for i = loCount - 1 to 0
            LsPivot pv = array.get(lsLows, i)
            if not pv.mit
                if not pv.brk
                    if close < pv.prc
                        if not lsOnlyWicks
                            pv.brk := true
                        else
                            pv.mit := true
                    if not lsOnlyRetest and not pv.wic and low < pv.prc and close > pv.prc
                        f_lsArea(pv, lsBullFill, cBull, -1)
                        f_lsLevel(pv, lsBullLine, "dotted")
                        f_lsDot(high, cBull)
                        pv.wic := true
                else
                    if close > pv.prc
                        pv.mit := true
                    if not lsOnlyWicks and high > pv.prc and close < pv.prc
                        f_lsArea(pv, lsBearFill, cBear, 1)
                        f_lsLevel(pv, lsBearLine, "dashed")
                        f_lsDot(low, cBear)
                        pv.tak := true
            if bar_index - pv.bix > 2000 or pv.mit or pv.tak
                array.remove(lsLows, i)

    if lsExtend
        int areaCount = array.size(lsAreas)
        if areaCount > 0
            for i = 0 to areaCount - 1
                LsArea area = array.get(lsAreas, i)
                if not area.done and bar_index - box.get_left(area.bx) - 1 <= lsMaxBars
                    box.set_right(area.bx, bar_index)
                    if area.dir == -1 and close < box.get_bottom(area.bx)
                        area.done := true
                    if area.dir == 1 and close > box.get_top(area.bx)
                        area.done := true

// ===== Swing highs/lows with candle patterns (adapted from swing_h_l_candle.pine) =====
// The pivot is confirmed swLen bars after the swing candle, so the pattern is read
// on that older candle (offset swLen). Engulfing uses the candle before it.
// The source file's bearish engulfing test duplicated the bullish one; it is
// corrected here to a real bearish engulfing.
var float swPrevHigh = na
var float swPrevLow = na
var array<label> swLabels = array.new<label>()

float swO = open[swLen]
float swH = high[swLen]
float swL = low[swLen]
float swC = close[swLen]
float swBody = math.abs(swC - swO)
float swLowerWick = math.min(swO, swC) - swL
float swUpperWick = swH - math.max(swO, swC)
float swPh = ta.pivothigh(swLen, swLen)
float swPl = ta.pivotlow(swLen, swLen)

bool swBullEng = swC > swO and close[swLen + 1] < open[swLen + 1] and swC > open[swLen + 1] and swO < close[swLen + 1]
bool swBearEng = swC < swO and close[swLen + 1] > open[swLen + 1] and swC < open[swLen + 1] and swO > close[swLen + 1]

string swPattern = ""
if swEnabled and swPatterns and (not na(swPh) or not na(swPl))
    bool isHigh = not na(swPh)
    if not isHigh and swLowerWick > swBody and swUpperWick < swBody
        swPattern := "Hammer"
    else if not isHigh and swUpperWick > swBody and swLowerWick < swBody
        swPattern := "Inverted Hammer"
    else if isHigh and swLowerWick > swBody and swUpperWick < swBody
        swPattern := "Hanging Man"
    else if isHigh and swUpperWick > swBody and swLowerWick < swBody
        swPattern := "Shooting Star"
    else if not isHigh and swBullEng
        swPattern := "Bullish Engulfing"
    else if isHigh and swBearEng
        swPattern := "Bearish Engulfing"

if swEnabled and not na(swPh)
    string tag = na(swPrevHigh) or swPh > swPrevHigh ? "HH" : "LH"
    swLabels.push(label.new(bar_index - swLen, swPh, tag + (swPattern == "" ? "" : "\n" + swPattern), color = color(na), style = label.style_label_down, textcolor = cBear, force_overlay = true))
    swPrevHigh := swPh
else if swEnabled and not na(swPl)
    string tag = na(swPrevLow) or swPl < swPrevLow ? "LL" : "HL"
    swLabels.push(label.new(bar_index - swLen, swPl, tag + (swPattern == "" ? "" : "\n" + swPattern), color = color(na), style = label.style_label_up, textcolor = cBull, force_overlay = true))
    swPrevLow := swPl
f_trimLabels(swLabels, swMaxLabels)

// ===== Sessions (adapted from session.pine) =====
// Session hours are evaluated in ssTz. The running high/low restarts at each new
// session start and holds its last value between sessions.
f_session(string sess) =>
    int t = time(ssRes, sess, ssTz)
    bool isNew = (na(t[1]) and not na(t)) or t[1] < t
    bool inSess = not na(time(timeframe.period, sess, ssTz))
    var float lo = na
    var float hi = na
    if inSess
        lo := isNew or na(lo) ? low : math.min(lo, low)
        hi := isNew or na(hi) ? high : math.max(hi, high)
    [lo, hi, inSess]

[ssLnLo, ssLnHi, ssLnIn] = f_session(ssLondon)
[ssNyLo, ssNyHi, ssNyIn] = f_session(ssNy)
[ssTkLo, ssTkHi, ssTkIn] = f_session(ssTokyo)
[ssSyLo, ssSyHi, ssSyIn] = f_session(ssSydney)

color ssClear = color.new(color.black, 100)
ssLnLoP = plot(ssLondonOn and ssHighLow ? ssLnLo : na, "London low", ssClear, editable = false, force_overlay = true)
ssLnHiP = plot(ssLondonOn and ssHighLow ? ssLnHi : na, "London high", ssClear, editable = false, force_overlay = true)
ssNyLoP = plot(ssNyOn and ssHighLow ? ssNyLo : na, "New York low", ssClear, editable = false, force_overlay = true)
ssNyHiP = plot(ssNyOn and ssHighLow ? ssNyHi : na, "New York high", ssClear, editable = false, force_overlay = true)
ssTkLoP = plot(ssTokyoOn and ssHighLow ? ssTkLo : na, "Tokyo low", ssClear, editable = false, force_overlay = true)
ssTkHiP = plot(ssTokyoOn and ssHighLow ? ssTkHi : na, "Tokyo high", ssClear, editable = false, force_overlay = true)
ssSyLoP = plot(ssSydneyOn and ssHighLow ? ssSyLo : na, "Sydney low", ssClear, editable = false, force_overlay = true)
ssSyHiP = plot(ssSydneyOn and ssHighLow ? ssSyHi : na, "Sydney high", ssClear, editable = false, force_overlay = true)
fill(ssLnLoP, ssLnHiP, ssLnIn and ssLondonOn and ssHighLow ? ssLondonCss : na)
fill(ssNyLoP, ssNyHiP, ssNyIn and ssNyOn and ssHighLow ? ssNyCss : na)
fill(ssTkLoP, ssTkHiP, ssTkIn and ssTokyoOn and ssHighLow ? ssTokyoCss : na)
fill(ssSyLoP, ssSyHiP, ssSyIn and ssSydneyOn and ssHighLow ? ssSydneyCss : na)
bgcolor(ssLnIn and ssLondonOn and not ssHighLow ? ssLondonCss : na, force_overlay = true)
bgcolor(ssNyIn and ssNyOn and not ssHighLow ? ssNyCss : na, force_overlay = true)
bgcolor(ssTkIn and ssTokyoOn and not ssHighLow ? ssTokyoCss : na, force_overlay = true)
bgcolor(ssSyIn and ssSydneyOn and not ssHighLow ? ssSydneyCss : na, force_overlay = true)

// ===== ICT price action tools (adapted from ict_price_action.pine) =====
// Market structure, swing dots, order/breaker blocks, buyside/sellside liquidity
// and liquidity voids. Swing labels are created only when displayed and filled
// voids are deleted, to protect the shared 500 label/box budget.
type IctState
    float lastPrice
    float midPrice
    float prevPrice
    int lastIndex
    int midIndex
    int prevIndex
    bool isCrossed = false

type IctKind
    int v = 0

type IctZz
    array<int> d
    array<int> x
    array<float> y

type IctLiq
    box bx
    box bxt
    line ln
    line lne
    bool brL = false

bool ictDraw = last_bar_index - bar_index <= ictLookback

f_ictLineStyle(string s) =>
    s == "Dotted" ? line.style_dotted : s == "Dashed" ? line.style_dashed : line.style_solid

f_ictPattern(float lastP, float midP, float prevP, bool isHigh) =>
    isHigh ? (prevP < midP and midP >= lastP) : (prevP > midP and midP <= lastP)

method isPattern(IctState this, bool isHigh) =>
    f_ictPattern(this.lastPrice, this.midPrice, this.prevPrice, isHigh)

method shiftIn(IctState this, float price, int index) =>
    this.isCrossed := false
    this.prevPrice := this.midPrice
    this.midPrice := this.lastPrice
    this.lastPrice := price
    this.prevIndex := this.midIndex
    this.midIndex := this.lastIndex
    this.lastIndex := index

var array<int> ictMsX1 = array.new<int>()
var array<int> ictMsX2 = array.new<int>()
var array<float> ictMsY = array.new<float>()
var array<bool> ictMsBull_ = array.new<bool>()
var array<string> ictMsTxt = array.new<string>()
var array<line> ictMsLines = array.new<line>()
var array<label> ictMsLabels = array.new<label>()

method renderStructure(IctState this, IctKind ms, bool isBullish, bool draw) =>
    bool crossed = isBullish ? close > this.lastPrice : close < this.lastPrice
    if crossed and not this.isCrossed
        this.isCrossed := true
        if draw
            ictMsX1.push(this.lastIndex)
            ictMsX2.push(bar_index)
            ictMsY.push(this.lastPrice)
            ictMsBull_.push(isBullish)
            ictMsTxt.push(ms.v == (isBullish ? -1 : 1) ? "MSS" : "BOS")
            if ictMsY.size() > ictMsKeep
                ictMsX1.shift()
                ictMsX2.shift()
                ictMsY.shift()
                ictMsBull_.shift()
                ictMsTxt.shift()
        ms.v := isBullish ? 1 : -1

method roll(IctZz this, int d, int x, float y) =>
    this.d.unshift(d)
    this.x.unshift(x)
    this.y.unshift(y)
    this.d.pop()
    this.x.pop()
    this.y.pop()

// ----- swings: 3-bar fractals -> intermediate -> long term -----
var IctState ictStLow = IctState.new()
var IctState ictStHigh = IctState.new()
var IctState ictItLow = IctState.new()
var IctState ictItHigh = IctState.new()
var IctState ictLtLow = IctState.new()
var IctState ictLtHigh = IctState.new()
var IctKind ictStKind = IctKind.new()
var IctKind ictItKind = IctKind.new()
var IctKind ictLtKind = IctKind.new()

if f_ictPattern(low, low[1], low[2], false)
    ictStLow.shiftIn(low[1], bar_index - 1)

if f_ictPattern(high, high[1], high[2], true)
    ictStHigh.shiftIn(high[1], bar_index - 1)

bool ictCItl = ictStLow.isPattern(false)
if ictCItl and not ictCItl[1]
    ictItLow.shiftIn(ictStLow.midPrice, ictStLow.midIndex)

bool ictCIth = ictStHigh.isPattern(true)
if ictCIth and not ictCIth[1]
    ictItHigh.shiftIn(ictStHigh.midPrice, ictStHigh.midIndex)

bool ictCLtl = ictItLow.isPattern(false)
if ictCLtl and not ictCLtl[1]
    ictLtLow.isCrossed := false
    ictLtLow.lastPrice := ictItLow.midPrice
    ictLtLow.lastIndex := ictItLow.midIndex

bool ictCLth = ictItHigh.isPattern(true)
if ictCLth and not ictCLth[1]
    ictLtHigh.isCrossed := false
    ictLtHigh.lastPrice := ictItHigh.midPrice
    ictLtHigh.lastIndex := ictItHigh.midIndex

// ----- market structure -----
if ictMsOn
    if ictMsTerm == "Short Term"
        ictStLow.renderStructure(ictStKind, false, ictDraw)
        ictStHigh.renderStructure(ictStKind, true, ictDraw)
    else if ictMsTerm == "Intermediate Term"
        ictItLow.renderStructure(ictItKind, false, ictDraw)
        ictItHigh.renderStructure(ictItKind, true, ictDraw)
    else
        ictLtLow.renderStructure(ictLtKind, false, ictDraw)
        ictLtHigh.renderStructure(ictLtKind, true, ictDraw)

// Structure events are stored as data and drawn once on the last bar, so the
// objects are the newest and are not evicted by the shared 500-object limit.
if barstate.islast and ictMsOn
    f_clearLines(ictMsLines)
    f_clearLabels(ictMsLabels)
    if ictMsY.size() > 0
        for i = 0 to ictMsY.size() - 1
            bool bull = ictMsBull_.get(i)
            color clr = bull ? cBull : cBear
            ictMsLines.push(line.new(ictMsX1.get(i), ictMsY.get(i), ictMsX2.get(i), ictMsY.get(i), color = clr, style = f_ictLineStyle(ictMsStyle), width = 2, force_overlay = true))
            if ictMsText
                ictMsLabels.push(label.new(math.round((ictMsX1.get(i) + ictMsX2.get(i)) / 2.0), ictMsY.get(i), ictMsTxt.get(i), color = na, textcolor = clr, style = bull ? label.style_label_down : label.style_label_up, size = size.small, force_overlay = true))

// ----- buyside / sellside liquidity -----
int ictMaxZz = 50
float ictAtr = ta.atr(10)
var IctZz ictZz = IctZz.new(array.new<int>(ictMaxZz, 0), array.new<int>(ictMaxZz, 0), array.new<float>(ictMaxZz, na))
var array<IctLiq> ictLiqBuy = array.new<IctLiq>()
var array<IctLiq> ictLiqSell = array.new<IctLiq>()

f_ictLiqScan(bool isHigh, float swing, int swingX, array<IctLiq> store, color clr, string txt) =>
    int dir = ictZz.d.get(0)
    float y1 = ictZz.y.get(0)
    if isHigh
        if dir < 1
            ictZz.roll(1, swingX, swing)
        else if swing > y1
            ictZz.x.set(0, swingX)
            ictZz.y.set(0, swing)
    else
        if dir > -1
            ictZz.roll(-1, swingX, swing)
        else if swing < y1
            ictZz.x.set(0, swingX)
            ictZz.y.set(0, swing)
    float band = ictAtr / ictLiqMargin
    int count = 0
    int stB = 0
    float stP = 0.0
    float hiP = 0.0
    float loP = 10e6
    for i = 0 to ictMaxZz - 1
        if ictZz.d.get(i) == (isHigh ? 1 : -1)
            float yy = ictZz.y.get(i)
            if (isHigh and yy > swing + band) or (not isHigh and yy < swing - band)
                break
            else if yy > swing - band and yy < swing + band
                count += 1
                stB := ictZz.x.get(i)
                stP := yy
                hiP := math.max(hiP, yy)
                loP := math.min(loP, yy)
    if count > 2 and ictDraw
        float mid = math.avg(hiP, loP)
        if store.size() > 0 and stB == store.get(0).bx.get_left()
            store.get(0).bx.set_top(mid + band)
            store.get(0).bx.set_rightbottom(bar_index + 10, mid - band)
        else
            store.unshift(IctLiq.new(
                 box.new(stB, mid + band, bar_index + 10, mid - band, border_color = na, bgcolor = na, force_overlay = true),
                 box.new(stB, stP, bar_index + 10, stP, border_color = na, bgcolor = na, text = isHigh ? "Buyside liquidity" : "Sellside liquidity", text_size = size.tiny, text_halign = text.align_left, text_valign = isHigh ? text.align_bottom : text.align_top, text_color = color.new(clr, 25), force_overlay = true),
                 line.new(stB, stP, bar_index - 1, stP, color = clr, force_overlay = true),
                 line.new(bar_index - 1, stP, bar_index, stP, color = clr, style = line.style_dotted, force_overlay = true)))
        if store.size() > ictLiqVisible
            IctLiq last = store.pop()
            last.bx.delete()
            last.bxt.delete()
            last.ln.delete()
            last.lne.delete()
    true

float ictTopY = na
int ictTopX = na
float ictBtmY = na
int ictBtmX = na
if ictLiqOn
    if ictLiqTerm == "Short Term"
        ictTopY := ictStHigh.lastPrice
        ictTopX := ictStHigh.lastIndex
        ictBtmY := ictStLow.lastPrice
        ictBtmX := ictStLow.lastIndex
    else if ictLiqTerm == "Intermediate Term"
        ictTopY := ictItHigh.lastPrice
        ictTopX := ictItHigh.lastIndex
        ictBtmY := ictItLow.lastPrice
        ictBtmX := ictItLow.lastIndex
    else
        ictTopY := ictLtHigh.lastPrice
        ictTopX := ictLtHigh.lastIndex
        ictBtmY := ictLtLow.lastPrice
        ictBtmX := ictLtLow.lastIndex

float ictSwingHigh = nz(ictTopY, 0)
float ictSwingLow = nz(ictBtmY, 0)
if ictSwingHigh > 0 and ictSwingHigh != ictSwingHigh[1]
    f_ictLiqScan(true, ictSwingHigh, ictTopX, ictLiqBuy, cBull, "Buyside liquidity")
if ictSwingLow > 0 and ictSwingLow != ictSwingLow[1]
    f_ictLiqScan(false, ictSwingLow, ictBtmX, ictLiqSell, cBear, "Sellside liquidity")

if ictLiqBuy.size() > 0
    for i = 0 to ictLiqBuy.size() - 1
        IctLiq lq = ictLiqBuy.get(i)
        if not lq.brL
            lq.lne.set_x2(bar_index)
            if high > lq.bx.get_top()
                lq.brL := true

if ictLiqSell.size() > 0
    for i = 0 to ictLiqSell.size() - 1
        IctLiq lq = ictLiqSell.get(i)
        if not lq.brL
            lq.lne.set_x2(bar_index)
            if low < lq.bx.get_bottom()
                lq.brL := true


// Dealing range adaptation: isolated state; all price drawings stay on the chart.
type drx_Pivot
    int    bar
    float  price
    bool   taken
    bool   shifted

type drx_Region
    box    shape
    float  hi
    float  lo
    int    born
    int    dir
    bool   alive
    string kind







var box  drx_rngBox  = na
var line drx_rngTop  = na
var line drx_rngBot  = na
var line drx_rngEq   = na

var array<drx_Pivot>  drx_highs   = array.new<drx_Pivot>()
var array<drx_Pivot>  drx_lows    = array.new<drx_Pivot>()
var array<drx_Region> drx_obBull  = array.new<drx_Region>()
var array<drx_Region> drx_obBear  = array.new<drx_Region>()
var array<drx_Region> drx_bbBull  = array.new<drx_Region>()
var array<drx_Region> drx_bbBear  = array.new<drx_Region>()
var array<drx_Region> drx_fvgBull = array.new<drx_Region>()
var array<drx_Region> drx_fvgBear = array.new<drx_Region>()
var array<drx_Region> drx_ifvgBull = array.new<drx_Region>()
var array<drx_Region> drx_ifvgBear = array.new<drx_Region>()

var int  drx_bias       = 0
var bool drx_wantBullOB = false
var bool drx_wantBearOB = false

drx_nzAtr() =>
    float a = ta.atr(14)
    na(a) ? 0.0 : a

drx_inRange(float zHi, float zLo, float dHi, float dLo) =>
    not na(zHi) and not na(zLo) and not na(dHi) and not na(dLo) and zHi <= dHi and zLo >= dLo

drx_inWindow(int birthBar, int leftEdge) =>
    birthBar >= leftEdge

drx_pushRegion(array<drx_Region> bag, drx_Region r) =>
    bag.unshift(r)
    if bag.size() > drx_perKind
        drx_Region drop = bag.pop()
        box.delete(drop.shape)

drx_killRegion(drx_Region r, color paint) =>
    r.alive := false
    if drx_keepDead and not na(r.shape)
        box.set_bgcolor(r.shape, color.new(paint, drx_deadOp))
        box.set_border_color(r.shape, color.new(paint, drx_deadOp))
    else
        box.delete(r.shape)

drx_sweepGroup(array<drx_Region> bag, color paint, int ext, bool useAge, int maxAge) =>
    if bag.size() > 0
        for i = bag.size() - 1 to 0
            drx_Region r = bag.get(i)
            if r.alive
                bool gone = r.dir > 0 ? close < r.lo : close > r.hi
                bool old  = useAge and (bar_index - r.born) > maxAge
                bool drop = gone or old
                if drop
                    drx_killRegion(r, paint)
                    if not drx_keepDead
                        bag.remove(i)
                if not drop and not na(r.shape)
                    box.set_right(r.shape, bar_index + ext)

drx_pruneOutsideDR(array<drx_Region> bag, float dHi, float dLo, int leftEdge, bool filterOn) =>
    if filterOn and bag.size() > 0
        for i = bag.size() - 1 to 0
            drx_Region r = bag.get(i)
            if not drx_inRange(r.hi, r.lo, dHi, dLo) or not drx_inWindow(r.born, leftEdge)
                box.delete(r.shape)
                bag.remove(i)

drx_findOBCandle(int maxBack, bool needBearishCandle) =>
    int found = -1
    int n     = math.min(bar_index, maxBack)
    if n >= 1
        for k = 1 to n
            bool isBear = close[k] < open[k]
            bool isBull = close[k] > open[k]
            bool hit    = needBearishCandle ? isBear : isBull
            if hit
                found := k
                break
    found

float drx_drHi   = ta.highest(high, drx_drBars)
float drx_drLo   = ta.lowest (low,  drx_drBars)
float drx_drMd   = (drx_drHi + drx_drLo) * 0.5
int   drx_leftX  = math.max(bar_index - drx_drBars + 1, 0)
int   drx_rightX = bar_index + drx_drRight
bool  drx_drOk   = not na(drx_drHi) and not na(drx_drLo) and drx_drHi > drx_drLo

if barstate.islast and drx_enabled
    box.delete(drx_rngBox)
    line.delete(drx_rngTop)
    line.delete(drx_rngBot)
    line.delete(drx_rngEq)
    drx_rngBox := na
    drx_rngTop := na
    drx_rngBot := na
    drx_rngEq := na
    if drx_drOk
        if na(drx_rngBox)
            drx_rngBox := box.new(drx_leftX, drx_drHi, drx_rightX, drx_drLo, xloc=xloc.bar_index, bgcolor=drx_drFill, border_color=color.new(drx_drFill, 40), border_width=1, force_overlay = true)
        else
            box.set_lefttop(drx_rngBox, drx_leftX, drx_drHi)
            box.set_rightbottom(drx_rngBox, drx_rightX, drx_drLo)
            box.set_bgcolor(drx_rngBox, drx_drFill)
            box.set_border_color(drx_rngBox, color.new(drx_drFill, 40))

        if na(drx_rngTop)
            drx_rngTop := line.new(drx_leftX, drx_drHi, drx_rightX, drx_drHi, xloc=xloc.bar_index, color=drx_drTop, width=2, force_overlay = true)
        else
            line.set_xy1(drx_rngTop, drx_leftX, drx_drHi)
            line.set_xy2(drx_rngTop, drx_rightX, drx_drHi)
            line.set_color(drx_rngTop, drx_drTop)

        if na(drx_rngBot)
            drx_rngBot := line.new(drx_leftX, drx_drLo, drx_rightX, drx_drLo, xloc=xloc.bar_index, color=drx_drBot, width=2, force_overlay = true)
        else
            line.set_xy1(drx_rngBot, drx_leftX, drx_drLo)
            line.set_xy2(drx_rngBot, drx_rightX, drx_drLo)
            line.set_color(drx_rngBot, drx_drBot)

        if drx_drMid
            if na(drx_rngEq)
                drx_rngEq := line.new(drx_leftX, drx_drMd, drx_rightX, drx_drMd, xloc=xloc.bar_index, color=drx_drEq, width=1, style=line.style_dashed, force_overlay = true)
            else
                line.set_xy1(drx_rngEq, drx_leftX, drx_drMd)
                line.set_xy2(drx_rngEq, drx_rightX, drx_drMd)
                line.set_color(drx_rngEq, drx_drEq)
        else
            if not na(drx_rngEq)
                line.delete(drx_rngEq)
                drx_rngEq := na
    else
        if not na(drx_rngBox)
            box.delete(drx_rngBox)
            drx_rngBox := na
        if not na(drx_rngTop)
            line.delete(drx_rngTop)
            drx_rngTop := na
        if not na(drx_rngBot)
            line.delete(drx_rngBot)
            drx_rngBot := na
        if not na(drx_rngEq)
            line.delete(drx_rngEq)
            drx_rngEq := na

float drx_atrVal = drx_nzAtr()
bool  drx_atrOk  = drx_atrVal > 0

float drx_pvH = ta.pivothigh(high, drx_pivLen, drx_pivLen)
float drx_pvL = ta.pivotlow (low,  drx_pivLen, drx_pivLen)

if drx_enabled and barstate.isconfirmed
    if not na(drx_pvH)
        int pvBar = bar_index - drx_pivLen
        drx_highs.unshift(drx_Pivot.new(pvBar, drx_pvH, false, false))
        if drx_highs.size() > 15
            drx_highs.pop()

    if not na(drx_pvL)
        int pvBar = bar_index - drx_pivLen
        drx_lows.unshift(drx_Pivot.new(pvBar, drx_pvL, false, false))
        if drx_lows.size() > 15
            drx_lows.pop()

    bool drx_bullSwept = false
    bool drx_bearSwept = false

    if drx_highs.size() > 0
        int loopN = math.min(drx_highs.size() - 1, 10)
        for i = 0 to loopN
            drx_Pivot p = drx_highs.get(i)
            if not p.taken and high > p.price
                p.taken := true
                drx_bullSwept := true
                drx_highs.set(i, p)

    if drx_lows.size() > 0
        int loopN = math.min(drx_lows.size() - 1, 10)
        for i = 0 to loopN
            drx_Pivot p = drx_lows.get(i)
            if not p.taken and low < p.price
                p.taken := true
                drx_bearSwept := true
                drx_lows.set(i, p)

    if drx_bearSwept
        drx_wantBullOB := true
    if drx_bullSwept
        drx_wantBearOB := true

    bool drx_mssUp   = false
    bool drx_mssDown = false

    if drx_highs.size() >= 2
        int loopN = math.min(drx_highs.size() - 1, 10)
        for i = 1 to loopN
            drx_Pivot p = drx_highs.get(i)
            if not p.shifted
                if close > p.price
                    p.shifted := true
                    drx_bias      := 1
                    drx_mssUp     := true
                    drx_highs.set(i, p)
                break

    if drx_lows.size() >= 2
        int loopN = math.min(drx_lows.size() - 1, 10)
        for i = 1 to loopN
            drx_Pivot p = drx_lows.get(i)
            if not p.shifted
                if close < p.price
                    p.shifted := true
                    drx_bias      := -1
                    drx_mssDown   := true
                    drx_lows.set(i, p)
                break

    if drx_obOn
        if drx_mssUp and drx_wantBullOB
            int back = drx_findOBCandle(drx_obScan, true)
            if back >= 0
                float oHi = high[back]
                float oLo = low[back]
                int   oId = bar_index - back
                bool  ok  = drx_drOk and (not drx_obDR or drx_inRange(oHi, oLo, drx_drHi, drx_drLo)) and drx_inWindow(oId, drx_leftX)
                if ok
                    box bx = box.new(oId, oHi, bar_index + drx_obExt, oLo, bgcolor=drx_obUp, border_width=1, border_color=drx_obUp, text=drx_showLbl ? "OB+" : "", text_size=size.tiny, text_color=drx_txtCol, text_halign=text.align_right, force_overlay = true)
                    drx_pushRegion(drx_obBull, drx_Region.new(bx, oHi, oLo, oId, 1, true, "OB"))
            drx_wantBullOB := false

        if drx_mssDown and drx_wantBearOB
            int back = drx_findOBCandle(drx_obScan, false)
            if back >= 0
                float oHi = high[back]
                float oLo = low[back]
                int   oId = bar_index - back
                bool  ok  = drx_drOk and (not drx_obDR or drx_inRange(oHi, oLo, drx_drHi, drx_drLo)) and drx_inWindow(oId, drx_leftX)
                if ok
                    box bx = box.new(oId, oHi, bar_index + drx_obExt, oLo, bgcolor=drx_obDn, border_width=1, border_color=drx_obDn, text=drx_showLbl ? "OB-" : "", text_size=size.tiny, text_color=drx_txtCol, text_halign=text.align_right, force_overlay = true)
                    drx_pushRegion(drx_obBear, drx_Region.new(bx, oHi, oLo, oId, -1, true, "OB"))
            drx_wantBearOB := false

    if drx_bbOn and drx_highs.size() >= 2 and drx_lows.size() >= 2

        bool placedBear = false
        int  hCap       = math.min(drx_highs.size() - 2, 8)
        for hi = 0 to hCap
            if placedBear
                break
            drx_Pivot h2 = drx_highs.get(hi)
            drx_Pivot h1 = drx_highs.get(hi + 1)
            if h2.price > h1.price
                int lCap = math.min(drx_lows.size() - 1, 8)
                for j = 0 to lCap
                    drx_Pivot mid = drx_lows.get(j)
                    if h1.bar < mid.bar and mid.bar < h2.bar
                        if close < mid.price
                            int lb = bar_index - mid.bar
                            if lb >= 0 and lb < 500
                                float zHi = high[lb]
                                float zLo = low[lb]
                                bool dup = false
                                if drx_bbBear.size() > 0
                                    for d = 0 to drx_bbBear.size() - 1
                                        if drx_atrOk and math.abs(drx_bbBear.get(d).hi - zHi) < drx_atrVal * 0.05
                                            dup := true
                                            break
                                bool ok = not dup and drx_drOk and (not drx_bbDR or drx_inRange(zHi, zLo, drx_drHi, drx_drLo)) and drx_inWindow(mid.bar, drx_leftX)
                                if ok
                                    box bx = box.new(mid.bar, zHi, bar_index + drx_bbExt, zLo, bgcolor=drx_bbDn, border_width=1, border_color=drx_bbDn, text=drx_showLbl ? "BB-" : "", text_size=size.tiny, text_color=drx_txtCol, text_halign=text.align_right, force_overlay = true)
                                    drx_pushRegion(drx_bbBear, drx_Region.new(bx, zHi, zLo, mid.bar, -1, true, "BB"))
                                    placedBear := true
                        break

        bool placedBull = false
        int  lCap2      = math.min(drx_lows.size() - 2, 8)
        for li = 0 to lCap2
            if placedBull
                break
            drx_Pivot l2 = drx_lows.get(li)
            drx_Pivot l1 = drx_lows.get(li + 1)
            if l2.price < l1.price
                int hCap2 = math.min(drx_highs.size() - 1, 8)
                for j = 0 to hCap2
                    drx_Pivot mid = drx_highs.get(j)
                    if l1.bar < mid.bar and mid.bar < l2.bar
                        if close > mid.price
                            int lb = bar_index - mid.bar
                            if lb >= 0 and lb < 500
                                float zHi = high[lb]
                                float zLo = low[lb]
                                bool dup = false
                                if drx_bbBull.size() > 0
                                    for d = 0 to drx_bbBull.size() - 1
                                        if drx_atrOk and math.abs(drx_bbBull.get(d).lo - zLo) < drx_atrVal * 0.05
                                            dup := true
                                            break
                                bool ok = not dup and drx_drOk and (not drx_bbDR or drx_inRange(zHi, zLo, drx_drHi, drx_drLo)) and drx_inWindow(mid.bar, drx_leftX)
                                if ok
                                    box bx = box.new(mid.bar, zHi, bar_index + drx_bbExt, zLo, bgcolor=drx_bbUp, border_width=1, border_color=drx_bbUp, text=drx_showLbl ? "BB+" : "", text_size=size.tiny, text_color=drx_txtCol, text_halign=text.align_right, force_overlay = true)
                                    drx_pushRegion(drx_bbBull, drx_Region.new(bx, zHi, zLo, mid.bar, 1, true, "BB"))
                                    placedBull := true
                        break

    // Keep source gaps for IFVG detection even when their boxes are hidden.
    if drx_fvgOn or drx_ifvgOn

        float upBase = high[2]
        float upTop  = low
        bool  upGap  = not na(upBase) and not na(upTop) and upTop > upBase
        if upGap
            float thick   = upTop - upBase
            bool  thickOk = drx_atrOk and thick >= drx_atrVal * 0.1
            bool  win     = drx_drOk and (not drx_fvgDR or drx_inRange(upTop, upBase, drx_drHi, drx_drLo)) and drx_inWindow(bar_index - 1, drx_leftX)
            if thickOk and win
                box bx = na
                if drx_fvgOn
                    bx := box.new(bar_index - 1, upTop, bar_index + drx_fvgExt, upBase, bgcolor=drx_fvgUp, border_width=1, border_color=drx_fvgUp, text=drx_showLbl ? "FVG+" : "", text_size=size.tiny, text_color=drx_txtCol, text_halign=text.align_right, force_overlay = true)
                drx_pushRegion(drx_fvgBull, drx_Region.new(bx, upTop, upBase, bar_index - 1, 1, true, "FVG"))

        float dnBase = low[2]
        float dnBot  = high
        bool  dnGap  = not na(dnBase) and not na(dnBot) and dnBase > dnBot
        if dnGap
            float thick   = dnBase - dnBot
            bool  thickOk = drx_atrOk and thick >= drx_atrVal * 0.1
            bool  win     = drx_drOk and (not drx_fvgDR or drx_inRange(dnBase, dnBot, drx_drHi, drx_drLo)) and drx_inWindow(bar_index - 1, drx_leftX)
            if thickOk and win
                box bx = na
                if drx_fvgOn
                    bx := box.new(bar_index - 1, dnBase, bar_index + drx_fvgExt, dnBot, bgcolor=drx_fvgDn, border_width=1, border_color=drx_fvgDn, text=drx_showLbl ? "FVG-" : "", text_size=size.tiny, text_color=drx_txtCol, text_halign=text.align_right, force_overlay = true)
                drx_pushRegion(drx_fvgBear, drx_Region.new(bx, dnBase, dnBot, bar_index - 1, -1, true, "FVG"))

    if drx_ifvgOn

        if drx_fvgBull.size() > 0
            for i = drx_fvgBull.size() - 1 to 0
                drx_Region r = drx_fvgBull.get(i)
                if r.alive and r.kind == "FVG" and close < r.lo
                    bool win = not drx_ifvgDR or (drx_drOk and drx_inRange(r.hi, r.lo, drx_drHi, drx_drLo) and drx_inWindow(r.born, drx_leftX))
                    if win
                        box bx = box.new(r.born, r.hi, bar_index + drx_fvgExt, r.lo, bgcolor=drx_ifvgDn, border_width=1, border_color=drx_ifvgDn, text=drx_showLbl ? "IFVG-" : "", text_size=size.tiny, text_color=drx_txtCol, text_halign=text.align_right, force_overlay = true)
                        drx_pushRegion(drx_ifvgBear, drx_Region.new(bx, r.hi, r.lo, bar_index, -1, true, "IFVG"))
                    box.delete(r.shape)
                    drx_fvgBull.remove(i)

        if drx_fvgBear.size() > 0
            for i = drx_fvgBear.size() - 1 to 0
                drx_Region r = drx_fvgBear.get(i)
                if r.alive and r.kind == "FVG" and close > r.hi
                    bool win = not drx_ifvgDR or (drx_drOk and drx_inRange(r.hi, r.lo, drx_drHi, drx_drLo) and drx_inWindow(r.born, drx_leftX))
                    if win
                        box bx = box.new(r.born, r.hi, bar_index + drx_fvgExt, r.lo, bgcolor=drx_ifvgUp, border_width=1, border_color=drx_ifvgUp, text=drx_showLbl ? "IFVG+" : "", text_size=size.tiny, text_color=drx_txtCol, text_halign=text.align_right, force_overlay = true)
                        drx_pushRegion(drx_ifvgBull, drx_Region.new(bx, r.hi, r.lo, bar_index, 1, true, "IFVG"))
                    box.delete(r.shape)
                    drx_fvgBear.remove(i)

    drx_pruneOutsideDR(drx_obBull,  drx_drHi, drx_drLo, drx_leftX, drx_obDR)
    drx_pruneOutsideDR(drx_obBear,  drx_drHi, drx_drLo, drx_leftX, drx_obDR)
    drx_pruneOutsideDR(drx_bbBull,  drx_drHi, drx_drLo, drx_leftX, drx_bbDR)
    drx_pruneOutsideDR(drx_bbBear,  drx_drHi, drx_drLo, drx_leftX, drx_bbDR)
    drx_pruneOutsideDR(drx_fvgBull, drx_drHi, drx_drLo, drx_leftX, drx_fvgDR)
    drx_pruneOutsideDR(drx_fvgBear, drx_drHi, drx_drLo, drx_leftX, drx_fvgDR)
    drx_pruneOutsideDR(drx_ifvgBull, drx_drHi, drx_drLo, drx_leftX, drx_ifvgDR)
    drx_pruneOutsideDR(drx_ifvgBear, drx_drHi, drx_drLo, drx_leftX, drx_ifvgDR)

    drx_sweepGroup(drx_obBull,  drx_obUp,  drx_obExt,  false, 0)
    drx_sweepGroup(drx_obBear,  drx_obDn,  drx_obExt,  false, 0)
    drx_sweepGroup(drx_bbBull,  drx_bbUp,  drx_bbExt,  true,  drx_bbAge)
    drx_sweepGroup(drx_bbBear,  drx_bbDn,  drx_bbExt,  true,  drx_bbAge)
    drx_sweepGroup(drx_fvgBull, drx_fvgUp, drx_fvgExt, false, 0)
    drx_sweepGroup(drx_fvgBear, drx_fvgDn, drx_fvgExt, false, 0)
    drx_sweepGroup(drx_ifvgBull, drx_ifvgUp, drx_fvgExt, false, 0)
    drx_sweepGroup(drx_ifvgBear, drx_ifvgDn, drx_fvgExt, false, 0)


// BPR adaptation from bpr.pine (TakingProphets): retain gap prices instead of
// indexing arbitrarily old bars, and latch mitigation so faded zones stay stopped.
type BprGap
    float hi
    float lo
    float candleHigh
    float priorLow
    int leftTime

type BprZone
    box shape
    line midline
    bool active = true

f_bprZone(BprZone previous, BprGap opposite, float hi, float lo, bool bullish, int rightTime) =>
    if not na(previous)
        previous.shape.delete()
        previous.midline.delete()
    color paint = bullish ? bprBullColor : bprBearColor
    string font = bprLabelSize == "Tiny" ? size.tiny : bprLabelSize == "Small" ? size.small : bprLabelSize == "Large" ? size.large : size.normal
    box shape = box.new(opposite.leftTime, hi, rightTime, lo, xloc=xloc.bar_time, border_color=paint, bgcolor=paint, text=bprShowLabels ? "BPR" : "", text_size=font, text_color=color.white, text_halign=text.align_right, text_valign=text.align_bottom, force_overlay = true)
    line midline = na
    if bprShowMidpoint
        float mid = math.avg(hi, lo)
        string style = bprMidStyle == "Dashed" ? line.style_dashed : bprMidStyle == "Dotted" ? line.style_dotted : line.style_solid
        midline := line.new(opposite.leftTime, mid, rightTime, mid, xloc=xloc.bar_time, color=bprMidColor, width=bprMidWidth, style=style, force_overlay = true)
    BprZone.new(shape, midline)

f_bprUpdate(BprZone zone, bool bullish, int rightTime) =>
    bool mitigated = false
    if not na(zone) and zone.active
        float boundary = bullish ? zone.shape.get_bottom() : zone.shape.get_top()
        float bodyEdge = bullish ? math.min(open, close) : math.max(open, close)
        bool intact = bullish ? bodyEdge > boundary : bodyEdge < boundary
        bool broken = bullish ? bodyEdge < boundary : bodyEdge > boundary
        if intact
            zone.shape.set_right(rightTime)
            if not na(zone.midline)
                zone.midline.set_x2(rightTime)
        else if broken
            mitigated := true
            zone.active := false
            if bprShowMitigated
                color paint = bullish ? bprBullColor : bprBearColor
                zone.shape.set_right(time)
                zone.shape.set_bgcolor(color.new(paint, 95))
                zone.shape.set_border_color(color.new(paint, 95))
                if not na(zone.midline)
                    zone.midline.set_x2(time)
            else
                zone.shape.delete()
                zone.midline.delete()
    mitigated

float bprAtr = ta.atr(20)
float bprBody = math.abs(open - close)
bool bprBase = bprSensitivity == 0 or bprBody[1] > (bprBody + bprBody[2]) * 0.3
float bprMinimum = bprAtr * bprSensitivity * 0.08
bool bprNewBearGap = bprBase and low[2] > high and low[2] - high > bprMinimum
bool bprNewBullGap = bprBase and low > high[2] and low - high[2] > bprMinimum
var BprGap bprLastBull = na
var BprGap bprLastBear = na
var BprZone bprBullZone = na
var BprZone bprBearZone = na
if bprEnabled and barstate.isconfirmed
    int bprRightTime = na(time_close) ? time : time_close
    if bprNewBullGap
        bprLastBull := BprGap.new(low, high[2], high, low[2], time[1])
        if not na(bprLastBear)
            float hi = math.min(bprLastBear.hi, low)
            float lo = math.max(bprLastBear.lo, high[2])
            bool sourceCondition = bprLastBear.candleHigh + bprLastBear.priorLow + high[2] + low > math.max(bprLastBear.priorLow, low) - math.min(bprLastBear.candleHigh, high[2])
            if sourceCondition and hi > lo
                bprBullZone := f_bprZone(bprBullZone, bprLastBear, hi, lo, true, bprRightTime)
                alert("Bullish BPR detected", alert.freq_once_per_bar_close)
    if bprNewBearGap
        bprLastBear := BprGap.new(low[2], high, high, low[2], time[1])
        if not na(bprLastBull)
            float hi = math.min(bprLastBull.hi, low[2])
            float lo = math.max(bprLastBull.lo, high)
            bool sourceCondition = bprLastBull.candleHigh + bprLastBull.priorLow + high[2] + low > math.max(bprLastBull.priorLow, low) - math.min(bprLastBull.candleHigh, high[2])
            if sourceCondition and hi > lo
                bprBearZone := f_bprZone(bprBearZone, bprLastBull, hi, lo, false, bprRightTime)
                alert("Bearish BPR detected", alert.freq_once_per_bar_close)
    bool bprBullMitigated = f_bprUpdate(bprBullZone, true, bprRightTime)
    bool bprBearMitigated = f_bprUpdate(bprBearZone, false, bprRightTime)
    if bprBullMitigated
        alert("Bullish BPR mitigated", alert.freq_once_per_bar_close)
    if bprBearMitigated
        alert("Bearish BPR mitigated", alert.freq_once_per_bar_close)

// Reference only: no setup is evaluated and no points are awarded automatically.
f_checklistCell(table checklist, int column, int row, string value, color background, color foreground, string tip = "") =>
    string font = checklistTextSize == "Tiny" ? size.tiny : checklistTextSize == "Normal" ? size.normal : checklistTextSize == "Large" ? size.large : checklistTextSize == "Huge" ? size.huge : size.small
    table.cell(checklist, column, row, value, bgcolor = background, text_color = foreground, text_size = font, text_halign = text.align_left, tooltip = tip)

var table pullbackChecklist = table.new(position.top_right, 3, 22, bgcolor = showPullbackChecklist and checklistDisplay == "Top right panel" ? color.rgb(20, 25, 33) : na, frame_color = color.gray, frame_width = showPullbackChecklist and checklistDisplay == "Top right panel" ? 1 : 0, force_overlay = true)
var label pullbackChecklistLabel = na
if barstate.isfirst
    table.merge_cells(pullbackChecklist, 0, 0, 2, 0)
    for row = 16 to 21
        table.merge_cells(pullbackChecklist, 0, row, 2, row)
if barstate.islast and showPullbackChecklist and checklistDisplay == "Top right panel"
    color checklistBg = color.rgb(20, 25, 33)
    color checklistHeader = color.rgb(42, 49, 60)
    f_checklistCell(pullbackChecklist, 0, 0, "PULLBACK CHECKLIST | REFERENCE / 100", checklistHeader, color.white)
    f_checklistCell(pullbackChecklist, 0, 1, "Category / cap", checklistHeader, color.silver)
    f_checklistCell(pullbackChecklist, 1, 1, "Manual check (not evaluated)", checklistHeader, color.silver)
    f_checklistCell(pullbackChecklist, 2, 1, "Points", checklistHeader, color.silver)
    array<string> checklistGroups = array.from(
         "HTF / 25", "", "Geometry / 15", "", "", "Pullback / 15", "",
         "Confluence / 20", "", "", "ICT / SMC / 25", "", "", "Bonus")
    array<string> checklistRules = array.from(
         "[ ] H4 + Daily structure aligned",
         "[ ] Untapped liquidity draw / RR >= 2",
         "[ ] Prior clean swing touches",
         "[ ] Sustainable slope: 30-45 degrees",
         "[ ] Touch spacing: 10-20+ candles",
         "[ ] Bodies + volume fade; absorption wick",
         "[ ] Contact rejection / engulfing / reversal",
         "[ ] Horizontal S/R role reversal",
         "[ ] Fib 61.8-78.6% / 50%",
         "[ ] EMA20 / SMA50 / VWAP confluence",
         "[ ] Liquidity sweep + reclaim",
         "[ ] Unmitigated FVG at contact",
         "[ ] Breaker / mitigation / rejection block",
         "[ ] Descending triangle break + retest")
    array<string> checklistPoints = array.from(
         "15 / 0", "10 / 5 / 0", "5 (3+) / 2 (2)", "5 / 0", "5 / 0",
         "10 / 0", "5 / 0", "8 / 0", "6 / 3 / 0", "6 / 0",
         "10 / 0", "8 / 0", "7 / 0", "+5")
    array<string> checklistTips = array.from(
         "15: both H4 and Daily show HH/HL for longs or LH/LL for shorts, with structure intact. Zero alignment disqualifies the setup.",
         "10: clear untapped HTF pool (EQH/EQL, FVG, major D/W swing). 5: intermediate H1/H4 target. 0: no draw, obstacle or RR below 1:2.",
         "5: at least three distinct clean structural touches before this setup. 2: two prior touches. 0: one/arbitrary touch.",
         "5: sustainable 30-45 degree slope. 0 outside the awarded band; the rubric flags >60 or <20 as extreme. Visual angle depends on chart scale.",
         "5: distinct swings at least 10 candles apart, ideally 10-20+. 0 otherwise; fewer than five bars is clustered.",
         "10: progressively smaller countertrend bodies, declining volume and wicks toward the line. 0: aggressive countertrend impulse.",
         "5: rejection at the contact, with a wick at least 60% of the range, full-body engulfing, railroad tracks or morning/evening star. 0: neutral or breakdown close.",
         "8: the line intersects former resistance now support, or former support now resistance.",
         "6: contact inside the 61.8-78.6% retracement pocket. 3: contact at 50%. 0: neither.",
         "6: contact coincides with EMA20, SMA50, anchored VWAP or session VWAP.",
         "10: price sweeps the line or a nearby swing, then closes back on the trend side.",
         "8: an unmitigated three-candle FVG overlaps the line contact.",
         "7: an active breaker, mitigation or HTF rejection block overlaps the contact.",
         "5 bonus: descending triangle support breakdown and apex retest, or breakout above the descending line and support retest. Cap the final score at 100.")
    for i = 0 to 13
        f_checklistCell(pullbackChecklist, 0, i + 2, checklistGroups.get(i), checklistBg, color.silver)
        f_checklistCell(pullbackChecklist, 1, i + 2, checklistRules.get(i), checklistBg, color.white, checklistTips.get(i))
        f_checklistCell(pullbackChecklist, 2, i + 2, checklistPoints.get(i), checklistBg, color.aqua, checklistTips.get(i))
    f_checklistCell(pullbackChecklist, 0, 16, "HARD FAIL -> 0: HTF alignment = 0 / aggressive line breakdown", color.rgb(75, 25, 30), color.white)
    f_checklistCell(pullbackChecklist, 0, 17, "HARD FAIL -> 0: RR < 1:2 / high-impact news +/-15 min", color.rgb(75, 25, 30), color.white, "Check the economic calendar manually. News proximity is not evaluated by this panel.")
    f_checklistCell(pullbackChecklist, 0, 18, "Total = min(100, category points + bonus); hard fail overrides", checklistBg, color.silver)
    f_checklistCell(pullbackChecklist, 0, 19, "85-100 A+ | 70-84 A | 50-69 B | <50 Invalid", checklistHeader, color.white)
    f_checklistCell(pullbackChecklist, 0, 20, "Rubric minimum: 70 | Hover each check for full criteria", checklistBg, color.aqua)
    f_checklistCell(pullbackChecklist, 0, 21, "REFERENCE ONLY | No live score, entry or risk-sizing signal", checklistBg, color.silver)

if barstate.islast
    if not showPullbackChecklist or checklistDisplay != "Top right panel"
        table.clear(pullbackChecklist, 0, 0, 2, 21)
    if showPullbackChecklist and checklistDisplay == "Near latest price"
        string checklistLabelText = "PULLBACK CHECKLIST | REFERENCE / 100"
        checklistLabelText += "\nHTF: H4 + Daily structure aligned [15/0]"
        checklistLabelText += "\nLiquidity draw / RR >= 2 [10/5/0]"
        checklistLabelText += "\nPrior clean swing touches [5/2/0]"
        checklistLabelText += "\nTrendline slope 30-45 degrees [5/0]"
        checklistLabelText += "\nSwing spacing 10-20+ candles [5/0]"
        checklistLabelText += "\nCountertrend bodies / volume fade [10/0]"
        checklistLabelText += "\nContact rejection / reversal candle [5/0]"
        checklistLabelText += "\nHorizontal S/R role reversal [8/0]"
        checklistLabelText += "\nFib 61.8-78.6% / 50% [6/3/0]"
        checklistLabelText += "\nEMA20 / SMA50 / VWAP confluence [6/0]"
        checklistLabelText += "\nLiquidity sweep + reclaim [10/0]"
        checklistLabelText += "\nUnmitigated FVG at contact [8/0]"
        checklistLabelText += "\nBreaker / mitigation block [7/0]"
        checklistLabelText += "\nTriangle break + retest bonus [+5]"
        checklistLabelText += "\nHARD FAIL: no HTF alignment / line breakdown"
        checklistLabelText += "\nHARD FAIL: RR < 1:2 / high-impact news +/-15m"
        checklistLabelText += "\nREFERENCE ONLY | Total capped at 100; minimum 70"
        string checklistFont = checklistTextSize == "Tiny" ? size.tiny : checklistTextSize == "Normal" ? size.normal : checklistTextSize == "Large" ? size.large : checklistTextSize == "Huge" ? size.huge : size.small
        if na(pullbackChecklistLabel)
            pullbackChecklistLabel := label.new(bar_index + 2, close, checklistLabelText, xloc = xloc.bar_index, yloc = yloc.price, color = color.rgb(20, 25, 33), style = label.style_label_left, textcolor = color.white, size = checklistFont, textalign = text.align_left, force_overlay = true)
        else
            label.set_xy(pullbackChecklistLabel, bar_index + 2, close)
            label.set_text(pullbackChecklistLabel, checklistLabelText)
            label.set_textcolor(pullbackChecklistLabel, color.white)
            label.set_color(pullbackChecklistLabel, color.rgb(20, 25, 33))
            label.set_size(pullbackChecklistLabel, checklistFont)
    else if not na(pullbackChecklistLabel)
        label.delete(pullbackChecklistLabel)
        pullbackChecklistLabel := na
