string ictLiqTerm = input.string("Intermediate Term", "Detection", options = ["Short Term", "Intermediate Term", "Long Term"], group = G_ICT_LQ)
int ictLiqVisible = input.int(3, "Visible levels per side", minval = 1, maxval = 20, group = G_ICT_LQ)
string G_LS = "Liquidity sweeps (chart timeframe)"
bool lsEnabled = input.bool(true, "Show liquidity sweeps", group = G_LS, tooltip = "Adapted from Liquidity Sweeps by LuxAlgo (CC BY-NC-SA 4.0). A swing high/low is a liquidity pool; a sweep is price taking it out and reversing. Wick sweep: the wick pierces the swing level but the candle closes back on the other side. Outbreak and retest: price closes through the level, then later wicks back through it and closes on the original side. Sweeps are a context marker, not an entry signal.")
int lsLen = input.int(5, "Sweep swing length", minval = 1, maxval = 50, group = G_LS, tooltip = "Bars on each side that confirm a swing (confirmation delay = this many bars).")
string lsMode = input.string("Only Wicks", "Sweep type", options = ["Only Wicks", "Only Outbreaks & Retest", "Wicks + Outbreaks & Retest"], group = G_LS)
int lsMaxAreas = input.int(30, "Max sweep areas kept", minval = 1, maxval = 100, group = G_LS)
string G_SW = "Swing H/L + candle patterns (chart timeframe)"
bool swEnabled = input.bool(true, "Show swing highs/lows with candle pattern", group = G_SW, tooltip = "Adapted from Swing Highs/Lows & Candle Patterns. Labels each confirmed swing as HH/LH or HL/LL and names the candle pattern on the swing candle (hammer, inverted hammer, hanging man, shooting star) or a bullish/bearish engulfing there. Swings confirm this many bars late, so labels appear after the fact. Patterns are context, not entries.")
int swLen = input.int(21, "Swing length", minval = 1, maxval = 100, group = G_SW, tooltip = "Bars on each side of the swing candle.")
bool swPatterns = input.bool(true, "Show candle pattern name", group = G_SW)
string G_SD = "Supply and demand zones (chart timeframe)"
bool sdEnabled = input.bool(true, "Draw supply / demand zones", group = G_SD, tooltip = "Zone = 1-3 small-bodied base candles followed by a strong displacement close beyond the base. Detected at chart-candle close.")
bool sdDemand = input.bool(true, "Demand zones", inline = "sd1", group = G_SD)
bool sdSupply = input.bool(true, "Supply zones", inline = "sd1", group = G_SD)
float sdImpulseAtr = input.float(1.5, "Displacement body (ATR multiple)", minval = 0.5, step = 0.1, group = G_SD)
float sdBaseAtr = input.float(0.6, "Maximum base-candle body (ATR multiple)", minval = 0.1, step = 0.1, group = G_SD)
int sdMaxBase = input.int(3, "Maximum base candles", minval = 1, maxval = 3, group = G_SD)
int sdMaxZones = input.int(10, "Maximum active zones", minval = 2, maxval = 40, group = G_SD)
