string G_EW = "Elliott waves (chart timeframe, adapted from elliott.pine)"
bool ewEnabled = input.bool(false, "Draw Elliott waves", group = G_EW, tooltip = "Three zigzag lengths find 1-2-3-4-5 motive waves and a following (a)(b)(c) correction on the chart timeframe, with Fibonacci retracement zone and break marks. Adapted from the supplied elliott.pine (no licence stated in that file). Pivots confirm 1 bar after the swing for each length, so the last leg is provisional until the next swing forms. Pattern detection is a candidate, not a forecast.")
