bool lsExtend = input.bool(true, "Extend sweep area", group = G_LS)
int lsMaxBars = input.int(300, "Sweep area max bars", minval = 1, maxval = 5000, group = G_LS)
int lsMaxAreas = input.int(30, "Max sweep areas kept", minval = 1, maxval = 100, group = G_LS)
