//@version=6
indicator("MTF Bias, Structure & Strength", "MTF Bias", overlay = true, max_labels_count = 500, max_lines_count = 250, max_boxes_count = 100, dynamic_requests = true)

string G_DATA = "Data and indicators"
bool confirmed = input.bool(true, "Confirmed candles (recommended)", group = G_DATA, tooltip = "HTF/equal: previous closed candle. LTF: latest available closed intrabar. Off: live security values can repaint.")
int fastLen = input.int(20, "Fast EMA", minval = 2, maxval = 1000, group = G_DATA)
int midLen = input.int(50, "Middle EMA", minval = 2, maxval = 1000, group = G_DATA)
int slowLen = input.int(200, "Slow EMA", minval = 2, maxval = 1000, group = G_DATA)
int slopeBars = input.int(3, "EMA slope lookback", minval = 1, maxval = 100, group = G_DATA)
float slopeMin = input.float(0.0, "Minimum slope (ATR per bar)", minval = 0, step = 0.01, group = G_DATA)
int leftBars = input.int(3, "Pivot left bars", minval = 1, maxval = 25, group = G_DATA)
int rightBars = input.int(3, "Pivot right bars", minval = 1, maxval = 25, group = G_DATA)
int diLen = input.int(14, "DI length", minval = 2, maxval = 100, group = G_DATA)
int adxLen = input.int(14, "ADX smoothing", minval = 2, maxval = 100, group = G_DATA)
