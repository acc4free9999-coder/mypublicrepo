int zoneOpacity = input.int(80, "Zone transparency", minval = 40, maxval = 95, group = G_STYLE)
string G_ICT_MS = "ICT market structure (MSS / BOS)"
bool ictMsOn = input.bool(true, "Market structure", group = G_ICT_MS, tooltip = "Adapted from the supplied ict_price_action.pine (no licence stated). Swings are built from 3-bar fractals promoted to intermediate and long term. A close beyond the last swing draws BOS (same direction) or MSS (reversal). Swings confirm after the fact; context, not entries.")
string ictMsTerm = input.string("Intermediate Term", "Detection", options = ["Short Term", "Intermediate Term", "Long Term"], group = G_ICT_MS)
bool ictMsText = input.bool(true, "Labels", group = G_ICT_MS)
string G_ICT_LQ = "ICT buyside & sellside liquidity"
