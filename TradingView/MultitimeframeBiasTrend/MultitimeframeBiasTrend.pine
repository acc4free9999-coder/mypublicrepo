//@version=6
indicator("MTF Bias, Structure & Strength", "MTF Bias", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, dynamic_requests = true)

max_bars_back(time, 5000)
max_bars_back(high, 5000)
max_bars_back(low, 5000)
max_bars_back(close, 5000)
max_bars_back(volume, 5000)

string G_DATA = "Data and indicators"
bool confirmed = input.bool(true, "Confirmed candles (recommended)", group = G_DATA, tooltip = "HTF/equal: previous closed candle. LTF: latest available closed intrabar. Off: live security values can repaint.")
int fastLen = input.int(20, "Fast EMA", minval = 2, maxval = 1000, group = G_DATA)
int midLen = input.int(50, "Middle EMA", minval = 2, maxval = 1000, group = G_DATA)
int slowLen = input.int(200, "Slow EMA", minval = 2, maxval = 1000, group = G_DATA)
int slopeBars = input.int(3, "EMA slope lookback", minval = 1, maxval = 100, group = G_DATA)
float slopeMin = input.float(0.0, "Minimum slope (ATR per bar)", minval = 0, step = 0.01, group = G_DATA)
int leftBars = input.int(3, "Pivot left bars", minval = 1, maxval = 25, group = G_DATA)
int rightBars = input.int(3, "Pivot right bars", minval = 1, maxval = 25, group = G_DATA)
int diLen = input.int(14, "DI length", minval = 2, maxval = 100, group = G_DATA)
int adxLen = input.int(14, "ADX smoothing", minval = 2, maxval = 100, group = G_DATA)
float adxMin = input.float(25, "ADX trend threshold", minval = 1, maxval = 100, group = G_DATA)
bool useRsi = input.bool(true, "RSI score and direction confirmation", group = G_DATA)
int rsiLen = input.int(14, "RSI length", minval = 2, maxval = 100, group = G_DATA)
float rsiBand = input.float(2, "RSI neutral band: 50 +/-", minval = 0, maxval = 10, step = 0.5, group = G_DATA)
int atrLen = input.int(14, "ATR length", minval = 2, maxval = 100, group = G_DATA)
bool priceFilter = input.bool(false, "Require price above/below slow EMA", group = G_DATA)
int sourceBars = input.int(3000, "Security history budget (source bars)", minval = 1500, maxval = 10000, step = 500, group = G_DATA, tooltip = "Bounds higher/equal-timeframe and live requests. Older replay history may show N/A. Increasing this uses more memory and can change EMA/pivot initialization.")
int intrabarBars = input.int(10000, "Lower-timeframe history budget (source bars)", minval = 1500, maxval = 50000, step = 500, group = G_DATA, tooltip = "Bounds confirmed intrabar requests across chart history, not per chart candle. Lower this if replay exceeds memory limits; increase only if older intrabar coverage is needed.")

