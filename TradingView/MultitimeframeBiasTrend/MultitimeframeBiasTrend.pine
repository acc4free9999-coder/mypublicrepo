array<int> luxTrend = array.from(lxTr0a, lxTr0b, lxTr0c, lxTr1a, lxTr1b, lxTr1c, lxTr2a, lxTr2b, lxTr2c, lxTr3a, lxTr3b, lxTr3c, lxTr4a, lxTr4b, lxTr4c, lxTr5a, lxTr5b, lxTr5c, lxTr6a, lxTr6b, lxTr6c)
array<bool> luxActive = array.from(lxAc0a, lxAc0b, lxAc0c, lxAc1a, lxAc1b, lxAc1c, lxAc2a, lxAc2b, lxAc2c, lxAc3a, lxAc3b, lxAc3c, lxAc4a, lxAc4b, lxAc4c, lxAc5a, lxAc5b, lxAc5c, lxAc6a, lxAc6b, lxAc6c)
array<int> luxX = array.from(lxX0a, lxX0b, lxX0c, lxX1a, lxX1b, lxX1c, lxX2a, lxX2b, lxX2c, lxX3a, lxX3b, lxX3c, lxX4a, lxX4b, lxX4c, lxX5a, lxX5b, lxX5c, lxX6a, lxX6b, lxX6c)
array<float> luxY = array.from(lxY0a, lxY0b, lxY0c, lxY1a, lxY1b, lxY1c, lxY2a, lxY2b, lxY2c, lxY3a, lxY3b, lxY3c, lxY4a, lxY4b, lxY4c, lxY5a, lxY5b, lxY5c, lxY6a, lxY6b, lxY6c)

var array<label> tlLabelPool = array.new<label>()
if barstate.islast
    while array.size(tlLabelPool) > 0
        label.delete(array.pop(tlLabelPool))
    if tlEnabled and tlLabels
        for tfIndex = 0 to 6
            if array.get(tlTimeframes, tfIndex) and timeframe.in_seconds(array.get(tfs, tfIndex)) >= chartSeconds
                for lvl = 0 to 2
                    int slot = tfIndex * 3 + lvl
                    int luxDir = array.get(luxTrend, slot)
                    if array.get(luxActive, slot) and luxDir != 0 and not na(array.get(luxY, slot))
                        array.push(tlLabelPool, label.new(bar_index, array.get(luxY, slot), array.get(names, tfIndex) + (luxDir == -1 ? " down" : " up"), style = luxDir == -1 ? label.style_label_down : label.style_label_up, color = color.new(array.get(tlColors, tfIndex), 20), textcolor = color.white, size = size.tiny))

// Elliott waves adapted from the supplied elliott.pine (three zigzag lengths, 1-2-3-4-5 and a-b-c, Fibonacci zone, break marks).
type ZZ
    array<int> d
    array<int> x
    array<float> y
    array<line> l

type Ewave
    line   l1
    line   l2
    line   l3
    line   l4
    line   l5
    label  b1
    label  b2
    label  b3
    label  b4
    label  b5
    //
    bool   on
    bool   br //= na
    //
    int    dir
    //
    line   lA
    line   lB
    line   lC
    label  bA
    label  bB
    label  bC
    //
    bool next = false
    //
    label  lb
    box    bx

type fibL
    line wave1_0_500
    line wave1_0_618
    line wave1_0_764
    line wave1_0_854
    line wave1_pole_
    linefill l_fill_
    bool     _break_ //= na

float hi = ewSrcHigh == "high" ? high : ewSrcHigh == "close" ? close : math.max(open, close)
float lo = ewSrcLow == "low" ? low : ewSrcLow == "close" ? close : math.min(open, close)

in_out(aZZ, d, x1, y1, x2, y2, col) =>
    aZZ.d.unshift(d), aZZ.x.unshift(x2), aZZ.y.unshift(y2), aZZ.d.pop(), aZZ.x.pop(), aZZ.y.pop()
    if ewShowZz
        aZZ.l.unshift(line.new(x1, y1, x2, y2, color= col)), aZZ.l.pop().delete()

method isSame(Ewave gEW, _1x, _2x, _3x, _4x) =>
    t1 = _1x == gEW.l1.get_x1()
    t2 = _2x == gEW.l2.get_x1()
    t3 = _3x == gEW.l3.get_x1()
    t4 = _4x == gEW.l4.get_x1()
    t1 and t2 and t3 and t4

method isSame2(Ewave gEW, _1x, _2x, _3x) =>
    t1 = _1x == gEW.l3.get_x2()
    t2 = _2x == gEW.l4.get_x2()
    t3 = _3x == gEW.l5.get_x2()
    t1 and t2 and t3

method makeDotted(Ewave gEW) =>
    gEW.l1.set_style(line.style_dotted)
    gEW.l2.set_style(line.style_dotted)
    gEW.l3.set_style(line.style_dotted)
    gEW.l4.set_style(line.style_dotted)
    gEW.l5.set_style(line.style_dotted)
    gEW.b1.set_textcolor    (color(na))
    gEW.b2.set_textcolor    (color(na))
    gEW.b3.set_textcolor    (color(na))
    gEW.b4.set_textcolor    (color(na))
    gEW.b5.set_textcolor    (color(na))
    gEW.on := false

method makeDashed(Ewave gEW) =>
    gEW.lA.set_style(line.style_dashed)
    gEW.lB.set_style(line.style_dashed)
    gEW.lC.set_style(line.style_dashed)
    gEW.bA.set_textcolor    (color(na))
    gEW.bB.set_textcolor    (color(na))
    gEW.bC.set_textcolor    (color(na))
    gEW.bx.set_bgcolor      (color(na))
    gEW.bx.set_border_color (color(na))

method sol_dot(fibL nFibL, sol_dot, col) =>
    style =
     sol_dot ==  'dot'  ?
      line.style_dotted :
     sol_dot ==  'sol'  ?
      line.style_solid  :
      line.style_dashed
    nFibL.wave1_0_500.set_style(style)
    nFibL.wave1_0_618.set_style(style)
    nFibL.wave1_0_764.set_style(style)
    nFibL.wave1_0_854.set_style(style)
    nFibL.l_fill_.set_color(col)

method setLevels(fibL nFibL, int x1, int x2, float max_500, float max_618, float max_764, float max_854, float y2) =>
    nFibL.wave1_0_500.set_xy1(x1, max_500)
    nFibL.wave1_0_500.set_xy2(x2, max_500)
    nFibL.wave1_0_618.set_xy1(x1, max_618)
    nFibL.wave1_0_618.set_xy2(x2, max_618)
    nFibL.wave1_0_764.set_xy1(x1, max_764)
    nFibL.wave1_0_764.set_xy2(x2, max_764)
    nFibL.wave1_0_854.set_xy1(x1, max_854)
    nFibL.wave1_0_854.set_xy2(x2, max_854)
    nFibL.wave1_pole_.set_xy1(x1,     y2 )
    nFibL.wave1_pole_.set_xy2(x1, max_854)
    nFibL.l_fill_.get_line1().set_xy1(x1, max_764)
    nFibL.l_fill_.get_line1().set_xy2(x2, max_764)
    nFibL.l_fill_.get_line2().set_xy1(x1, max_854)
    nFibL.l_fill_.get_line2().set_xy2(x2, max_854)

method clearLevels(fibL nFibL) =>
    nFibL.wave1_0_500.set_xy1(na, na)
    nFibL.wave1_0_500.set_xy2(na, na)
    nFibL.wave1_0_618.set_xy1(na, na)
    nFibL.wave1_0_618.set_xy2(na, na)
    nFibL.wave1_0_764.set_xy1(na, na)
    nFibL.wave1_0_764.set_xy2(na, na)
    nFibL.wave1_0_854.set_xy1(na, na)
    nFibL.wave1_0_854.set_xy2(na, na)
    nFibL.wave1_pole_.set_xy1(na, na)
    nFibL.wave1_pole_.set_xy2(na, na)
    nFibL.l_fill_.set_color(color(na))

f_ewZigzag(bool enabled, int left, color col, int n) =>
    //
    var int dir = na
    var int x1 = na
    var float y1 = na
    var int x2 = na
    var float y2 = na
    var Ewave gEW = na
    var int last_0x = na
    var float last_0y = na
    var int last_6x = na
    var float last_6y = na
    //
    float ph = ta.pivothigh(hi, left, 1)
    float pl = ta.pivotlow(lo, left, 1)
    if enabled
        var fibL nFibL = fibL.new(
           wave1_0_500 = line.new(na, na, na, na, color= color.new(col, 50), style= line.style_solid ),
           wave1_0_618 = line.new(na, na, na, na, color= color.new(col, 38), style= line.style_solid ),
           wave1_0_764 = line.new(na, na, na, na, color= color.new(col, 24), style= line.style_solid ),
           wave1_0_854 = line.new(na, na, na, na, color= color.new(col, 15), style= line.style_solid ),
           wave1_pole_ = line.new(na, na, na, na, color= color.new(col, 50), style= line.style_dashed),
               l_fill_ = linefill.new(
                         line.new(na, na, na, na, color= color(na))
                       , line.new(na, na, na, na, color= color(na))
                       ,                          color= color(na))
                       ,                         _break_   =   false
               )
        //
        var  ZZ        aZZ   =   ZZ.new(array.new < int   > ()
                                      , array.new < int   > ()
                                      , array.new < float > ()
                                      , array.new < line  > () )
        var array<Ewave> aEW = array.new<Ewave>()
        //
        if barstate.isfirst
            aEW.unshift(Ewave.new())
            for i = 0 to 10
                aZZ.d.unshift(0)
                aZZ.x.unshift(0)
                aZZ.y.unshift(0)
                aZZ.l.unshift(ewShowZz ? line.new(na, na, na, na) : na)
        //
        sz       = aZZ.d.size( )
        x2      := bar_index -1
        t        = n == 2 ? '\n\n' : n == 1 ? '\n' : ''
        //
        // when a new Pivot High is found
        if not na(ph)
            gEW := aEW.get   (0)
            dir := aZZ.d.get (0)
            x1  := aZZ.x.get (0)
            y1  := aZZ.y.get (0)
            y2  :=      nz(hi[1])
            //
            if dir <  1  // if previous point was a pl, add, and change direction ( 1)
                in_out(aZZ,  1, x1, y1, x2, y2, col)
            else
                if dir ==  1 and ph > y1
                    aZZ.x.set(0, x2), aZZ.y.set(0, y2)
                    if ewShowZz
                        aZZ.l.get(0).set_xy2(x2, y2)
            //
            _6x = x2, _6y = y2
            _5x = aZZ.x.get(1), _5y = aZZ.y.get(1)
            _4x = aZZ.x.get(2), _4y = aZZ.y.get(2)
            _3x = aZZ.x.get(3), _3y = aZZ.y.get(3)
            _2x = aZZ.x.get(4), _2y = aZZ.y.get(4)
            _1x = aZZ.x.get(5), _1y = aZZ.y.get(5)
            //
            // –––––––––––––––––––––[ 12345 ]–––––––––––––––––––––
            _W5 = _6y - _5y
            _W3 = _4y - _3y
            _W1 = _2y - _1y
            min = math.min(_W1, _W3, _W5)
            isWave =
             _W3 != min and
             _6y  > _4y and
             _3y  > _1y and
             _5y  > _2y
            //
            same = gEW.isSame(_1x, _2x, _3x, _4x)
            if isWave
                if same
                    gEW.l5.set_xy2(_6x, _6y)
                    gEW.b5.set_xy (_6x, _6y)
                else
                    tx = ''
                    if _2x == aEW.get(0).b5.get_x()
                        tx := '(5) (1)'
                        aEW.get(0).b5.set_text('')
                    else
                        tx := '(1)'
                    //
                    wave = Ewave.new(
                     l1  = line.new (_1x, _1y, _2x, _2y                      , color=col       , style= line.style_solid     ),
                     l2  = line.new (_2x, _2y, _3x, _3y                      , color=col       , style= line.style_solid     ),
                     l3  = line.new (_3x, _3y, _4x, _4y                      , color=col       , style= line.style_solid     ),
                     l4  = line.new (_4x, _4y, _5x, _5y                      , color=col       , style= line.style_solid     ),
                     l5  = line.new (_5x, _5y, _6x, _6y                      , color=col       , style= line.style_solid     ),
                     b1  = label.new(_2x, _2y, text= tx    + t, textcolor=col, color= color(na), style=label.style_label_down),
                     b2  = label.new(_3x, _3y, text= t + '(2)', textcolor=col, color= color(na), style=label.style_label_up  ),
                     b3  = label.new(_4x, _4y, text= '(3)' + t, textcolor=col, color= color(na), style=label.style_label_down),
                     b4  = label.new(_5x, _5y, text= t + '(4)', textcolor=col, color= color(na), style=label.style_label_up  ),
                     b5  = label.new(_6x, _6y, text= '(5)' + t, textcolor=col, color= color(na), style=label.style_label_down),
                     on  = true                                                                                               ,
                     br  = false                                                                                              ,
                     dir = 1
                      )
                    aEW.unshift(wave)
                    nFibL._break_ := false
                    alert('New EW Motive Bullish Pattern found'  , alert.freq_once_per_bar_close)
            //
            if not isWave
                if same and gEW.on == true
                    gEW.makeDotted()
                    alert('Invalidated EW Motive Bullish Pattern', alert.freq_once_per_bar_close)
            //
            // –––––––––––––––––––––[ ABC ]–––––––––––––––––––––
            getEW    = aEW.get(0)
            last_0x := getEW.l1.get_x1(), last_0y := getEW.l1.get_y1()
            last_6x := getEW.l5.get_x2(), last_6y := getEW.l5.get_y2()
            diff     = math.abs(last_6y - last_0y)
            //
            if getEW.dir == -1
                getX    = getEW.l5.get_x2()
                getY    = getEW.l5.get_y2()
                isSame2 = getEW.isSame2  (_1x, _2x, _3x)
                isValid =
                   _3x == getX                  and
                   _6y  < getY + (diff * ewFib4) and
                   _4y  < getY + (diff * ewFib4) and
                   _5y  > getY
                //
                if isValid
                    width = _6x - _2x // –––[ width (4) - (c) ]–––
                    if isSame2 and getEW.bA.get_x() > _3x
                        getEW.lC.set_xy1(_5x, _5y), getEW.lC.set_xy2(_6x, _6y), getEW.bC.set_xy(_6x, _6y), getEW.bx.set_lefttop(_6x, _6y), getEW.bx.set_right(_6x + width)
                    else
                        getEW.lA := line.new (_3x, _3y, _4x, _4y, color=col), getEW.bA := label.new(_4x, _4y, text= '(a)' + t, textcolor=col, color= color(na), style=label.style_label_down)
                        getEW.lB := line.new (_4x, _4y, _5x, _5y, color=col), getEW.bB := label.new(_5x, _5y, text= t + '(b)', textcolor=col, color= color(na), style=label.style_label_up  )
                        getEW.lC := line.new (_5x, _5y, _6x, _6y, color=col), getEW.bC := label.new(_6x, _6y, text= '(c)' + t, textcolor=col, color= color(na), style=label.style_label_down)
                        getEW.bx := box.new  (_6x, _6y, _6x + width, _4y, bgcolor=color.new(col, 93), border_color=color.new(col, 65))
                        alert('New EW Corrective Bullish Pattern found'  , alert.freq_once_per_bar_close)
                else
                    if isSame2 and getEW.bA.get_x() > _3x
                        getEW.makeDashed()
                        alert('Invalidated EW Corrective Bullish Pattern', alert.freq_once_per_bar_close)
            //
            // –––––––––––––––––––––[ new (1) ? ]–––––––––––––––––––––
            if getEW.dir ==  1
                if _5x == getEW.bC.get_x() and
                   _6y >  getEW.b5.get_y() and
                   getEW.next  == false
                    getEW.next := true
                    getEW.lb   := label.new(_6x, _6y, style=label.style_circle, color=color.new(col, 65), yloc=yloc.abovebar, size=size.tiny)
                    alert('Possible new start of EW Motive Bullish Wave', alert.freq_once_per_bar_close)
        //
        // when a new Pivot Low is found
        if not na(pl)
            gEW := aEW.get   (0)
            dir := aZZ.d.get (0)
            x1  := aZZ.x.get (0)
            y1  := aZZ.y.get (0)
            y2  :=      nz(lo[1])
            //
            if dir > -1  // if previous point was a ph, add, and change direction (-1)
                in_out(aZZ, -1, x1, y1, x2, y2, col)
            else
                if dir == -1 and pl < y1
                    aZZ.x.set(0, x2), aZZ.y.set(0, y2)
                    if ewShowZz
                        aZZ.l.get(0).set_xy2(x2, y2)
            //
            _6x = x2, _6y = y2
            _5x = aZZ.x.get(1), _5y = aZZ.y.get(1)
            _4x = aZZ.x.get(2), _4y = aZZ.y.get(2)
            _3x = aZZ.x.get(3), _3y = aZZ.y.get(3)
            _2x = aZZ.x.get(4), _2y = aZZ.y.get(4)
            _1x = aZZ.x.get(5), _1y = aZZ.y.get(5)
            //
            // –––––––––––––––––––––[ 12345 ]–––––––––––––––––––––
            _W5 = _5y - _6y
            _W3 = _3y - _4y
            _W1 = _1y - _2y
            min = math.min(_W1, _W3, _W5)
            isWave =
             _W3 != min and
             _4y  > _6y and
             _1y  > _3y and
             _2y  > _5y
            //
            same = isSame(gEW, _1x, _2x, _3x, _4x)
            if isWave
                if same
                    gEW.l5.set_xy2(_6x, _6y)
                    gEW.b5.set_xy (_6x, _6y)
                else
                    tx = ''
                    if _2x == aEW.get(0).b5.get_x()
                        tx := '(5) (1)'
                        aEW.get(0).b5.set_text('')
                    else
                        tx := '(1)'
                    //
                    wave = Ewave.new(
                     l1  = line.new (_1x, _1y, _2x, _2y                      , color=col       , style= line.style_solid     ),
                     l2  = line.new (_2x, _2y, _3x, _3y                      , color=col       , style= line.style_solid     ),
                     l3  = line.new (_3x, _3y, _4x, _4y                      , color=col       , style= line.style_solid     ),
                     l4  = line.new (_4x, _4y, _5x, _5y                      , color=col       , style= line.style_solid     ),
                     l5  = line.new (_5x, _5y, _6x, _6y                      , color=col       , style= line.style_solid     ),
                     b1  = label.new(_2x, _2y, text= t    + tx, textcolor=col, color= color(na), style=label.style_label_up  ),
                     b2  = label.new(_3x, _3y, text= '(2)' + t, textcolor=col, color= color(na), style=label.style_label_down),
                     b3  = label.new(_4x, _4y, text= t + '(3)', textcolor=col, color= color(na), style=label.style_label_up  ),
                     b4  = label.new(_5x, _5y, text= '(4)' + t, textcolor=col, color= color(na), style=label.style_label_down),
                     b5  = label.new(_6x, _6y, text= t + '(5)', textcolor=col, color= color(na), style=label.style_label_up  ),
                     on  = true                                                                                               ,
                     br  = false                                                                                              ,
                     dir =-1
                      )
                    aEW.unshift(wave)
                    nFibL._break_ := false
                    alert('New EW Motive Bearish Pattern found'  , alert.freq_once_per_bar_close)
            //
            if not isWave
                if same and gEW.on == true
                    gEW.makeDotted()
                    alert('Invalidated EW Motive Bearish Pattern', alert.freq_once_per_bar_close)
            //
            // –––––––––––––––––––––[ ABC ]–––––––––––––––––––––
            getEW    = aEW.get(0)
            last_0x := getEW.l1.get_x1(), last_0y := getEW.l1.get_y1()
            last_6x := getEW.l5.get_x2(), last_6y := getEW.l5.get_y2()
            diff     = math.abs(last_6y - last_0y)
            //
            if getEW.dir ==  1
                getX    = getEW.l5.get_x2()
                getY    = getEW.l5.get_y2()
                isSame2 = getEW.isSame2  (_1x, _2x, _3x)
                isValid =
                   _3x == getX                  and
                   _6y  > getY - (diff * ewFib4) and
                   _4y  > getY - (diff * ewFib4) and
                   _5y  < getY
                //
                if isValid
                    width = _6x - _2x // –––[ width (4) - (c) ]–––
                    if isSame2 and getEW.bA.get_x() > _3x
                        getEW.lC.set_xy1(_5x, _5y), getEW.lC.set_xy2(_6x, _6y), getEW.bC.set_xy(_6x, _6y), getEW.bx.set_lefttop(_6x, _6y), getEW.bx.set_right(_6x + width)
                    else
                        getEW.lA := line.new (_3x, _3y, _4x, _4y, color=col), getEW.bA := label.new(_4x, _4y, text= t + '(a)', textcolor=col, color= color(na), style=label.style_label_up  )
                        getEW.lB := line.new (_4x, _4y, _5x, _5y, color=col), getEW.bB := label.new(_5x, _5y, text= '(b)' + t, textcolor=col, color= color(na), style=label.style_label_down)
                        getEW.lC := line.new (_5x, _5y, _6x, _6y, color=col), getEW.bC := label.new(_6x, _6y, text= t + '(c)', textcolor=col, color= color(na), style=label.style_label_up  )
                        getEW.bx := box.new  (_6x, _6y, _6x + width, _4y, bgcolor=color.new(col, 93), border_color=color.new(col, 65))
                        alert('New EW Corrective Bearish Pattern found'  , alert.freq_once_per_bar_close)
                else
                    if isSame2 and getEW.bA.get_x() > _3x
                        getEW.makeDashed()
                        alert('Invalidated EW Corrective Bullish Pattern', alert.freq_once_per_bar_close)
            //
            // –––[ check (only once) for a possible new (1) after an impulsive AND corrective wave ]–––
            if getEW.dir == -1
                if _5x == getEW.bC.get_x() and
                   _6y <  getEW.b5.get_y() and
                   getEW.next  == false
                    getEW.next := true
                    getEW.lb   := label.new(_6x, _6y, style=label.style_circle, color=color.new(col, 65), yloc=yloc.belowbar, size=size.tiny)
                    alert('Possible new start of EW Motive Bearish Wave', alert.freq_once_per_bar_close)
        //
        // –––[ check for break box ]–––
        if aEW.size() > 0
            gEW    := aEW.get(0)
            if gEW.dir == 1
                if ta.crossunder(low , gEW.bx.get_bottom()) and bar_index <= gEW.bx.get_right()
                    label.new(bar_index, low , yloc= yloc.belowbar, style= label.style_xcross, color=color.red, size=size.tiny)
            else
                if ta.crossover (high, gEW.bx.get_top   ()) and bar_index <= gEW.bx.get_right()
                    label.new(bar_index, high, yloc= yloc.abovebar, style= label.style_xcross, color=color.red, size=size.tiny)
        //
        if barstate.islast
            //  –––[ get last 2 EW's ]–––
            getEW    = aEW.get(0)
            if aEW.size() > 1
                getEW1   = aEW.get(1)
                last_0x := getEW.l1.get_x1(), last_0y := getEW.l1.get_y1()
                last_6x := getEW.l5.get_x2(), last_6y := getEW.l5.get_y2()
                //
                diff = math.abs(last_6y - last_0y) // –––[ max/min difference ]–––
                _500 = diff * ewFib1
                _618 = diff * ewFib2
                _764 = diff * ewFib3
                _854 = diff * ewFib4
                bull = getEW.dir == 1
                // –––[ if EW is not valid or an ABC has developed -> remove fibonacci lines ]–––
                if getEW.on == false or getEW.bC.get_x() > getEW.b5.get_x()
                    nFibL.clearLevels()
                else
                // –––[ get.on == true ~ valid EW ]–––
                    max_500 = last_6y + ((bull ? -1 : 1) * _500)
                    max_618 = last_6y + ((bull ? -1 : 1) * _618)
                    max_764 = last_6y + ((bull ? -1 : 1) * _764)
                    max_854 = last_6y + ((bull ? -1 : 1) * _854)
                    //
                    nFibL.setLevels(last_6x, bar_index + 10, max_500, max_618, max_764, max_854, last_6y)
                // –––[ if (2) label overlap with (C) label ]–––
                if  getEW.b2.get_x() == getEW1.bC.get_x()
                    getEW.b1.set_textcolor(color(na))
                    getEW.b2.set_textcolor(color(na))
                    strB  = getEW1.bB.get_text()
                    strC  = getEW1.bC.get_text()
                    strB_ = str.replace(strB, "(b)",  "(b) (1)", 0)
                    strC_ = str.replace(strC, "(c)",  "(c) (2)", 0)
                    getEW1.bB.set_text(strB_)
                    getEW1.bC.set_text(strC_)
            //
            // –––[ check if fib limits are broken ]–––
            float getP_854 = nFibL.wave1_0_854.get_y1()
            int fibX = nFibL.wave1_0_854.get_x1()
            for i = 0 to (na(fibX) ? 0 : math.max(bar_index - fibX, 0))
                if getEW.dir == -1
                    if high[i] > getP_854
                        nFibL._break_ := true
                        break
                else
                    if low [i] < getP_854
                        nFibL._break_ := true
                        break
            //––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
            if nFibL._break_
                nFibL.sol_dot('dot', color.new(color.red, 95))
            else
                nFibL.sol_dot('sol', color.new(color.lime, 95))

        if aEW.size() > ewMaxWaves
            pop = aEW.pop()
            pop.l1.delete(), pop.b1.delete()
            pop.l2.delete(), pop.b2.delete()
            pop.l3.delete(), pop.b3.delete()
            pop.l4.delete(), pop.b4.delete()
            pop.l5.delete(), pop.b5.delete()
            pop.lA.delete(), pop.bA.delete()
            pop.lB.delete(), pop.bB.delete()
            pop.lC.delete(), pop.bC.delete()
            pop.lb.delete(), pop.bx.delete()
        //----------------------------------


f_ewZigzag(ewEnabled and ewOn1, ewLen1, ewCol1, 0)
f_ewZigzag(ewEnabled and ewOn2, ewLen2, ewCol2, 1)
f_ewZigzag(ewEnabled and ewOn3, ewLen3, ewCol3, 2)

var array<box> sdBoxes = array.new<box>()
var array<int> sdDirs = array.new<int>()
var array<float> sdTops = array.new<float>()
var array<float> sdBottoms = array.new<float>()
var array<int> sdTests = array.new<int>()
bool sdTestedDemand = false
bool sdTestedSupply = false
float sdAtr = ta.atr(atrLen)
float sdLimit = sdBaseAtr * sdAtr
bool sdSmall1 = math.abs(close[1] - open[1]) <= sdLimit
bool sdSmall2 = sdSmall1 and math.abs(close[2] - open[2]) <= sdLimit
bool sdSmall3 = sdSmall2 and math.abs(close[3] - open[3]) <= sdLimit
int sdBase = sdSmall3 and sdMaxBase >= 3 ? 3 : sdSmall2 and sdMaxBase >= 2 ? 2 : sdSmall1 ? 1 : 0
float sdBaseHigh = sdBase == 3 ? math.max(high[1], high[2], high[3]) : sdBase == 2 ? math.max(high[1], high[2]) : high[1]
float sdBaseLow = sdBase == 3 ? math.min(low[1], low[2], low[3]) : sdBase == 2 ? math.min(low[1], low[2]) : low[1]
float sdBodyHigh = sdBase == 3 ? math.max(math.max(open[1], close[1]), math.max(open[2], close[2]), math.max(open[3], close[3])) : sdBase == 2 ? math.max(math.max(open[1], close[1]), math.max(open[2], close[2])) : math.max(open[1], close[1])
float sdBodyLow = sdBase == 3 ? math.min(math.min(open[1], close[1]), math.min(open[2], close[2]), math.min(open[3], close[3])) : sdBase == 2 ? math.min(math.min(open[1], close[1]), math.min(open[2], close[2])) : math.min(open[1], close[1])
if sdEnabled and barstate.isconfirmed
    int total = array.size(sdBoxes)
    if total > 0
        for i = total - 1 to 0
            int dir = array.get(sdDirs, i)
            float top = array.get(sdTops, i)
            float bottom = array.get(sdBottoms, i)
            bool broken = dir == 1 ? close < bottom : close > top
            if broken
                box.delete(array.get(sdBoxes, i))
                array.remove(sdBoxes, i)
                array.remove(sdDirs, i)
                array.remove(sdTops, i)
                array.remove(sdBottoms, i)
                array.remove(sdTests, i)
            else if (dir == 1 and low <= top) or (dir == -1 and high >= bottom)
                array.set(sdTests, i, array.get(sdTests, i) + 1)
                sdTestedDemand := sdTestedDemand or dir == 1
                sdTestedSupply := sdTestedSupply or dir == -1
                if sdText
                    box.set_text(array.get(sdBoxes, i), (dir == 1 ? "D" : "S") + " x" + str.tostring(array.get(sdTests, i)))
    // Creation runs after mitigation, so the displacement candle cannot test its own new zone.
    float body = math.abs(close - open)
    int newDir = sdBase > 0 and not na(sdAtr) and body >= sdImpulseAtr * sdAtr ? (close > open and close > sdBaseHigh and sdDemand ? 1 : close < open and close < sdBaseLow and sdSupply ? -1 : 0) : 0
    if newDir != 0
        float zoneTop = newDir == 1 ? sdBodyHigh : (sdWicks ? sdBaseHigh : sdBodyHigh)
        float zoneBottom = newDir == 1 ? (sdWicks ? sdBaseLow : sdBodyLow) : sdBodyLow
        bool overlaps = false
        int zoneCount = array.size(sdBoxes)
        // Pine loops count downward when the end is below the start, so guard empty arrays.
        if zoneCount > 0
            for i = 0 to zoneCount - 1
                if array.get(sdDirs, i) == newDir and zoneTop >= array.get(sdBottoms, i) and zoneBottom <= array.get(sdTops, i)
                    overlaps := true
        if not overlaps and zoneTop > zoneBottom
            color zoneColor = newDir == 1 ? sdDemandColor : sdSupplyColor
            array.push(sdBoxes, box.new(bar_index - sdBase, zoneTop, bar_index, zoneBottom, border_color = zoneColor, bgcolor = color.new(zoneColor, sdOpacity), extend = extend.right, text = sdText ? (newDir == 1 ? "D" : "S") : "", text_color = textColor, text_size = size.tiny, text_halign = text.align_right))
            array.push(sdDirs, newDir)
            array.push(sdTops, zoneTop)
            array.push(sdBottoms, zoneBottom)
            array.push(sdTests, 0)
            if array.size(sdBoxes) > sdMaxZones
                box.delete(array.shift(sdBoxes))
                array.shift(sdDirs)
                array.shift(sdTops)
                array.shift(sdBottoms)
                array.shift(sdTests)

// Fair value gaps and order blocks (original implementation of the public FVG / order block concepts).
var array<box> fvBoxes = array.new<box>()
var array<int> fvDirs = array.new<int>()
var array<float> fvTops = array.new<float>()
var array<float> fvBots = array.new<float>()
var array<bool> fvDone = array.new<bool>()
var array<box> obBoxes = array.new<box>()
var array<int> obDirs = array.new<int>()
var array<float> obTops = array.new<float>()
var array<float> obBots = array.new<float>()
var array<bool> obDone = array.new<bool>()
var float obHighPrice = na
var int obHighBar = na
var bool obHighUsed = true
var float obLowPrice = na
var int obLowBar = na
var bool obLowUsed = true

f_zoneColor(color base) => color.new(base, foOpacity)

f_freeze(array<box> boxes, array<bool> done, int i) =>
    box zone = array.get(boxes, i)
    box.set_extend(zone, extend.none)
    box.set_right(zone, bar_index)
    box.set_bgcolor(zone, color.new(color.gray, 90))
    box.set_text_color(zone, color.new(color.gray, 40))
    array.set(done, i, true)

f_dropZone(array<box> boxes, array<int> dirs, array<float> tops, array<float> bots, array<bool> done, int i) =>
    box.delete(array.get(boxes, i))
    array.remove(boxes, i)
    array.remove(dirs, i)
    array.remove(tops, i)
    array.remove(bots, i)
    array.remove(done, i)

f_trimZones(array<box> boxes, array<int> dirs, array<float> tops, array<float> bots, array<bool> done, int side) =>
    int total = array.size(dirs)
    int same = 0
    int oldest = -1
    if total > 0
        for i = 0 to total - 1
            if array.get(dirs, i) == side
                same += 1
                if oldest < 0
                    oldest := i
    if same > foMax and oldest >= 0
        f_dropZone(boxes, dirs, tops, bots, done, oldest)

f_newZone(array<box> boxes, array<int> dirs, array<float> tops, array<float> bots, array<bool> done, int leftBar, float top, float bottom, int dir, color base, string txt) =>
    array.push(boxes, box.new(leftBar, top, bar_index, bottom, border_color = na, bgcolor = f_zoneColor(base), extend = extend.right, text = foLabels ? txt : "", text_size = size.tiny, text_color = color.white, text_halign = text.align_center))
    array.push(dirs, dir)
    array.push(tops, top)
    array.push(bots, bottom)
    array.push(done, false)

float foAtr = ta.atr(atrLen)
float foPh = ta.pivothigh(high, obSwing, obSwing)
float foPl = ta.pivotlow(low, obSwing, obSwing)
if not na(foPh)
    obHighPrice := foPh
    obHighBar := bar_index - obSwing
    obHighUsed := false
if not na(foPl)
    obLowPrice := foPl
    obLowBar := bar_index - obSwing
    obLowUsed := false

if barstate.isconfirmed
    // Mitigation first, on zones created on earlier bars.
    int fvCount = array.size(fvDirs)
    if fvCount > 0
        for i = fvCount - 1 to 0
            if not array.get(fvDone, i)
                int dir = array.get(fvDirs, i)
                float top = array.get(fvTops, i)
                float bot = array.get(fvBots, i)
                bool hit = fvMitigation == "Touch" ? (high >= bot and low <= top) : fvMitigation == "50% fill" ? (dir == 1 ? low <= (top + bot) / 2 : high >= (top + bot) / 2) : (dir == 1 ? low < bot : high > top)
                if hit
                    if foHide
                        f_dropZone(fvBoxes, fvDirs, fvTops, fvBots, fvDone, i)
                    else
                        f_freeze(fvBoxes, fvDone, i)
    int obCount = array.size(obDirs)
    if obCount > 0
        for i = obCount - 1 to 0
            if not array.get(obDone, i)
                int dir = array.get(obDirs, i)
                float srcLow = obMitigation == "Close" ? close : low
                float srcHigh = obMitigation == "Close" ? close : high
                bool hit = dir == 1 ? srcLow < array.get(obBots, i) : srcHigh > array.get(obTops, i)
                if hit
                    if foHide
                        f_dropZone(obBoxes, obDirs, obTops, obBots, obDone, i)
                    else
                        f_freeze(obBoxes, obDone, i)

    if fvEnabled and bar_index >= 2 and not na(foAtr)
        if low > high[2] and low - high[2] >= fvMinAtr * foAtr
            f_newZone(fvBoxes, fvDirs, fvTops, fvBots, fvDone, bar_index - 2, low, high[2], 1, fvBullColor, "FVG")
        else if high < low[2] and low[2] - high >= fvMinAtr * foAtr
            f_newZone(fvBoxes, fvDirs, fvTops, fvBots, fvDone, bar_index - 2, low[2], high, -1, fvBearColor, "FVG")

    bool dispOk = obDispAtr <= 0 or (not na(foAtr) and high - low >= obDispAtr * foAtr)
    if obEnabled and dispOk
        if not obHighUsed and (obBreakMode == "Wick" ? high : close) > obHighPrice
            obHighUsed := true
            int span = math.min(bar_index - obHighBar, 500)
            int pick = -1
            float pickLow = na
            for k = 0 to span
                if close[k] < open[k] and (na(pickLow) or low[k] < pickLow)
                    pick := k
                    pickLow := low[k]
            if pick < 0
                for k = 0 to span
                    if na(pickLow) or low[k] < pickLow
                        pick := k
                        pickLow := low[k]
            float zTop = obBodyOnly ? math.max(open[pick], close[pick]) : high[pick]
            float zBot = obBodyOnly ? math.min(open[pick], close[pick]) : low[pick]
            f_newZone(obBoxes, obDirs, obTops, obBots, obDone, bar_index - pick, zTop, zBot, 1, obBullColor, "OB")
        if not obLowUsed and (obBreakMode == "Wick" ? low : close) < obLowPrice
            obLowUsed := true
            int span = math.min(bar_index - obLowBar, 500)
            int pick = -1
            float pickHigh = na
            for k = 0 to span
                if close[k] > open[k] and (na(pickHigh) or high[k] > pickHigh)
                    pick := k
                    pickHigh := high[k]
            if pick < 0
                for k = 0 to span
                    if na(pickHigh) or high[k] > pickHigh
                        pick := k
                        pickHigh := high[k]
            float zTop = obBodyOnly ? math.max(open[pick], close[pick]) : high[pick]
            float zBot = obBodyOnly ? math.min(open[pick], close[pick]) : low[pick]
            f_newZone(obBoxes, obDirs, obTops, obBots, obDone, bar_index - pick, zTop, zBot, -1, obBearColor, "OB")

    f_trimZones(fvBoxes, fvDirs, fvTops, fvBots, fvDone, 1)
    f_trimZones(fvBoxes, fvDirs, fvTops, fvBots, fvDone, -1)
    f_trimZones(obBoxes, obDirs, obTops, obBots, obDone, 1)
    f_trimZones(obBoxes, obDirs, obTops, obBots, obDone, -1)

// Liquidity sweeps: adapted from "Liquidity Sweeps [LuxAlgo]" (CC BY-NC-SA 4.0, https://creativecommons.org/licenses/by-nc-sa/4.0/).
type LsPivot
    float prc
    int bix
    bool brk
    bool mit
    bool tak
    bool wic
    line lin

type LsArea
    box bx
    line ln
    bool done
    int dir

var array<LsPivot> lsHighs = array.new<LsPivot>()
var array<LsPivot> lsLows = array.new<LsPivot>()
var array<LsArea> lsAreas = array.new<LsArea>()

f_lsLevel(LsPivot pv, color c, string styleName) =>
    string st = styleName == "dotted" ? line.style_dotted : line.style_dashed
    line.new(pv.bix, pv.prc, bar_index, pv.prc, color = c, style = st)

f_lsArea(LsPivot pv, color fill, color edge, int dir) =>
    float y1 = dir == 1 ? high : pv.prc
    float y2 = dir == 1 ? pv.prc : low
    LsArea area = LsArea.new(box.new(bar_index - 1, y1, bar_index + 1, y2, border_color = na, bgcolor = fill), line.new(bar_index, y1, bar_index, y2, color = edge, width = 3), false, dir)
    array.unshift(lsAreas, area)
    if array.size(lsAreas) > lsMaxAreas
        LsArea old = array.pop(lsAreas)
        box.delete(old.bx)
        line.delete(old.ln)
    true

f_lsDot(float y, color c) =>
    line.new(bar_index, y, bar_index + 3, y, color = c, style = line.style_dotted)

float lsPh = ta.pivothigh(high, lsLen, lsLen)
float lsPl = ta.pivotlow(low, lsLen, lsLen)
bool lsOnlyWicks = lsMode == "Only Wicks"
bool lsOnlyRetest = lsMode == "Only Outbreaks & Retest"
color lsBullFill = color.new(lsBull, 75)
color lsBearFill = color.new(lsBear, 75)
color lsBullLine = color.new(lsBull, 50)
color lsBearLine = color.new(lsBear, 50)

if lsEnabled
    if not na(lsPh)
        array.unshift(lsHighs, LsPivot.new(lsPh, bar_index - lsLen, false, false, false, false, na))
    if not na(lsPl)
        array.unshift(lsLows, LsPivot.new(lsPl, bar_index - lsLen, false, false, false, false, na))

    int hiCount = array.size(lsHighs)
    if hiCount > 0
        for i = hiCount - 1 to 0
            LsPivot pv = array.get(lsHighs, i)
            if not pv.mit
                if not pv.brk
                    if close > pv.prc
                        if not lsOnlyWicks
                            pv.brk := true
                        else
                            pv.mit := true
                    if not lsOnlyRetest and not pv.wic and high > pv.prc and close < pv.prc
                        f_lsArea(pv, lsBearFill, lsBear, 1)
                        f_lsLevel(pv, lsBearLine, "dotted")
                        f_lsDot(low, lsBear)
                        pv.wic := true
                else
                    if close < pv.prc
                        pv.mit := true
                    if not lsOnlyWicks and low < pv.prc and close > pv.prc
                        f_lsArea(pv, lsBullFill, lsBull, -1)
                        f_lsLevel(pv, lsBullLine, "dashed")
                        f_lsDot(high, lsBull)
                        pv.tak := true
            if bar_index - pv.bix > 2000 or pv.mit or pv.tak
                array.remove(lsHighs, i)

    int loCount = array.size(lsLows)
    if loCount > 0
        for i = loCount - 1 to 0
            LsPivot pv = array.get(lsLows, i)
            if not pv.mit
                if not pv.brk
                    if close < pv.prc
                        if not lsOnlyWicks
                            pv.brk := true
                        else
                            pv.mit := true
                    if not lsOnlyRetest and not pv.wic and low < pv.prc and close > pv.prc
                        f_lsArea(pv, lsBullFill, lsBull, -1)
                        f_lsLevel(pv, lsBullLine, "dotted")
                        f_lsDot(high, lsBull)
                        pv.wic := true
                else
                    if close > pv.prc
                        pv.mit := true
                    if not lsOnlyWicks and high > pv.prc and close < pv.prc
                        f_lsArea(pv, lsBearFill, lsBear, 1)
                        f_lsLevel(pv, lsBearLine, "dashed")
                        f_lsDot(low, lsBear)
                        pv.tak := true
            if bar_index - pv.bix > 2000 or pv.mit or pv.tak
                array.remove(lsLows, i)

    if lsExtend
        int areaCount = array.size(lsAreas)
        if areaCount > 0
            for i = 0 to areaCount - 1
                LsArea area = array.get(lsAreas, i)
                if not area.done and bar_index - box.get_left(area.bx) - 1 <= lsMaxBars
                    box.set_right(area.bx, bar_index)
                    if area.dir == -1 and close < box.get_bottom(area.bx)
                        area.done := true
                    if area.dir == 1 and close > box.get_top(area.bx)
                        area.done := true

// Optional overlays use chart OHLC, not requested source OHLC on synthetic charts.
Snapshot chartData = f_engine(0)
Snapshot chartClosed = barstate.isconfirmed ? chartData : chartData[1]
plot(showSlow and not na(chartClosed) ? chartClosed.slow : na, "Chart slow EMA", color = color.orange, linewidth = 2)
plot(showSwings and not na(chartClosed) ? chartClosed.swingHigh : na, "Confirmed swing high", color = bearColor, style = plot.style_stepline)
plot(showSwings and not na(chartClosed) ? chartClosed.swingLow : na, "Confirmed swing low", color = bullColor, style = plot.style_stepline)
var array<label> chartLabels = array.new<label>()
bool chartBreak = barstate.isconfirmed and chartData.breakTime == time
if barstate.isconfirmed
    if showStructureLabels and not na(chartData.pivotHigh)
        string highText = chartData.highKind == 1 ? "HH" : chartData.highKind == -1 ? "LH" : "SH / Equal"
        f_addLabel(chartLabels, highText + " confirmed", high, true, neutralColor)
    if showStructureLabels and not na(chartData.pivotLow)
        string lowText = chartData.lowKind == 1 ? "HL" : chartData.lowKind == -1 ? "LL" : "SL / Equal"
        f_addLabel(chartLabels, lowText + " confirmed", low, false, neutralColor)
    if showBreaks and chartBreak
        string breakText = math.abs(chartData.breakCode) == 2 ? "CHoCH" : "BOS"
        f_addLabel(chartLabels, breakText + (chartData.breakCode > 0 ? " UP" : " DOWN"), chartData.breakCode > 0 ? low : high, chartData.breakCode < 0, chartData.breakCode > 0 ? bullColor : bearColor)

var int lastDirection = 0
var int priorHtfAlignment = 0
var bool priorPullback = false
var string lastRegime = ""
bool flipBull = false
bool flipBear = false
bool newHtfBull = false
bool newHtfBear = false
bool newPullback = false
bool newTrend = false
if barstate.isconfirmed
    if complete
        int direction = f_sign(overall.bias)
        flipBull := direction == 1 and lastDirection == -1
        flipBear := direction == -1 and lastDirection == 1
        if direction != 0
            lastDirection := direction
        newHtfBull := htfAlignment == 1 and priorHtfAlignment != 1
        newHtfBear := htfAlignment == -1 and priorHtfAlignment != -1
        newPullback := conflict and not priorPullback
        newTrend := condition == "Trending" and lastRegime == "Ranging"
        if condition != "Mixed"
            lastRegime := condition
        priorHtfAlignment := htfAlignment
        priorPullback := conflict
    else
        lastDirection := 0
        priorHtfAlignment := 0
        priorPullback := false
        lastRegime := ""

// ===== Volume profile (adapted from volume_profile.pine) =====
// Volume of every bar is spread over each price row its high-low range overlaps.
// The profile is rebuilt from the last vpLength bars; it describes the past and
// repaints as the window moves.
f_vpProfile(int len, int rows, float lo, float hi) =>
    array<float> sums = array.new_float(rows, 0.0)
    float step = (hi - lo) / rows
    if step > 0
        for k = 0 to len - 1
            float bh = high[k]
            float bl = low[k]
            float bv = nz(volume[k])
            if not na(bh) and not na(bl) and bv > 0
                int r1 = math.max(0, math.min(rows - 1, int(math.floor((bl - lo) / step))))
                int r2 = math.max(0, math.min(rows - 1, int(math.floor((bh - lo) / step))))
                for r = r1 to r2
                    sums.set(r, sums.get(r) + bv)
    sums

var array<line> vpLines = array.new<line>()
var line vpPoc = na
if barstate.isfirst and vpEnabled
    for i = 0 to vpRows - 1
        vpLines.push(line.new(na, na, na, na))
    vpPoc = line.new(na, na, na, na, style = line.style_dotted)

int vpLen = math.min(vpLength, bar_index + 1)
float vpHi = ta.highest(high, vpLength)
float vpLo = ta.lowest(low, vpLength)
float vpRollPoc = na
if vpEnabled and (vpRolling or barstate.islast) and vpLen >= 2 and vpHi > vpLo
    array<float> vpSums = f_vpProfile(vpLen, vpRows, vpLo, vpHi)
    float vpMax = vpSums.max()
    if vpMax > 0
        int pocRow = vpSums.indexof(vpMax)
        float vpStep = (vpHi - vpLo) / vpRows
        vpRollPoc := vpLo + (pocRow + 0.5) * vpStep
        if barstate.islast
            for j = 0 to vpRows - 1
                float mult = vpSums.get(j) / vpMax
                float y = vpLo + (j + 0.5) * vpStep
                int len = int(math.round(vpLen * vpWidth / 100.0 * mult))
                line l = vpLines.get(j)
                if len < 1
                    l.set_xy1(na, na)
                    l.set_xy2(na, na)
                else
                    if vpFlip
                        l.set_xy1(bar_index, y)
                        l.set_xy2(bar_index - len, y)
                    else
                        l.set_xy1(bar_index - vpLen + 1, y)
                        l.set_xy2(bar_index - vpLen + 1 + len, y)
                    l.set_color(vpGrad ? color.from_gradient(mult, 0, 1, vpLow, vpHigh) : vpSolid)
                    l.set_width(vpBarWidth)
            vpPoc.set_xy1(bar_index - vpLen + 1, vpRollPoc)
            vpPoc.set_xy2(bar_index, vpRollPoc)
            vpPoc.set_color(vpGrad ? vpHigh : vpPocColor)
            vpPoc.set_width(vpBarWidth)
plot(vpEnabled and vpRolling ? vpRollPoc : na, "Rolling POC", color = color.rgb(255, 17, 0))

// ===== Swing highs/lows with candle patterns (adapted from swing_h_l_candle.pine) =====
// The pivot is confirmed swLen bars after the swing candle, so the pattern is read
// on that older candle (offset swLen). Engulfing uses the candle before it.
// The source file's bearish engulfing test duplicated the bullish one; it is
// corrected here to a real bearish engulfing.
var float swPrevHigh = na
var float swPrevLow = na
var array<label> swLabels = array.new<label>()

float swO = open[swLen]
float swH = high[swLen]
float swL = low[swLen]
float swC = close[swLen]
float swBody = math.abs(swC - swO)
float swLowerWick = math.min(swO, swC) - swL
float swUpperWick = swH - math.max(swO, swC)
float swPh = ta.pivothigh(swLen, swLen)
float swPl = ta.pivotlow(swLen, swLen)

bool swBullEng = swC > swO and close[swLen + 1] < open[swLen + 1] and swC > open[swLen + 1] and swO < close[swLen + 1]
bool swBearEng = swC < swO and close[swLen + 1] > open[swLen + 1] and swC < open[swLen + 1] and swO > close[swLen + 1]

string swPattern = ""
if swEnabled and swPatterns and (not na(swPh) or not na(swPl))
    bool isHigh = not na(swPh)
    if not isHigh and swLowerWick > swBody and swUpperWick < swBody
        swPattern := "Hammer"
    else if not isHigh and swUpperWick > swBody and swLowerWick < swBody
        swPattern := "Inverted Hammer"
    else if isHigh and swLowerWick > swBody and swUpperWick < swBody
        swPattern := "Hanging Man"
    else if isHigh and swUpperWick > swBody and swLowerWick < swBody
        swPattern := "Shooting Star"
    else if not isHigh and swBullEng
        swPattern := "Bullish Engulfing"
    else if isHigh and swBearEng
        swPattern := "Bearish Engulfing"

if swEnabled and not na(swPh)
    string tag = na(swPrevHigh) or swPh > swPrevHigh ? "HH" : "LH"
    swLabels.push(label.new(bar_index - swLen, swPh, tag + (swPattern == "" ? "" : "\n" + swPattern), color = color(na), style = label.style_label_down, textcolor = swHighCss))
    swPrevHigh := swPh
else if swEnabled and not na(swPl)
    string tag = na(swPrevLow) or swPl < swPrevLow ? "LL" : "HL"
    swLabels.push(label.new(bar_index - swLen, swPl, tag + (swPattern == "" ? "" : "\n" + swPattern), color = color(na), style = label.style_label_up, textcolor = swLowCss))
    swPrevLow := swPl
if swLabels.size() > swMaxLabels
    swLabels.shift().delete()

alertcondition(alertFlip and flipBull, "Overall turns bullish", "{{ticker}}: overall bias reversed bullish at chart close. Directional context, not an entry.")
alertcondition(alertFlip and flipBear, "Overall turns bearish", "{{ticker}}: overall bias reversed bearish at chart close. Directional context, not an entry.")
alertcondition(alertHtf and newHtfBull, "HTF bullish alignment", "{{ticker}}: enabled higher timeframes aligned bullish at chart close.")
alertcondition(alertHtf and newHtfBear, "HTF bearish alignment", "{{ticker}}: enabled higher timeframes aligned bearish at chart close.")
alertcondition(alertPullback and newPullback, "LTF pullback against HTF", "{{ticker}}: lower-timeframe bias opposes higher-timeframe alignment. Pullback watch, not an entry.")
alertcondition(alertTrend and newTrend, "Ranging to trending", "{{ticker}}: weighted market condition changed from ranging to trending, allowing an intervening mixed phase.")
alertcondition(alertStructure and chartBreak and chartData.breakCode > 0, "Chart bullish structure break", "{{ticker}} {{interval}}: candle closed above an unbroken confirmed swing high (BOS or CHoCH).")
alertcondition(sdEnabled and sdTestedDemand, "Price tests demand zone", "{{ticker}} {{interval}}: candle closed after trading into an active demand zone. Context, not an entry.")
alertcondition(sdEnabled and sdTestedSupply, "Price tests supply zone", "{{ticker}} {{interval}}: candle closed after trading into an active supply zone. Context, not an entry.")
alertcondition(alertStructure and chartBreak and chartData.breakCode < 0, "Chart bearish structure break", "{{ticker}} {{interval}}: candle closed below an unbroken confirmed swing low (BOS or CHoCH).")

int columnCount = 1 + (colBias ? 1 : 0) + (colEma ? 1 : 0) + (colStructure ? 1 : 0) + (colAdx ? 1 : 0) + (colRsi ? 1 : 0) + (colScore ? 1 : 0) + (colPrice ? 1 : 0) + (colDistance ? 1 : 0) + (colAtr ? 1 : 0)
string panelPosition = locationInput == "Top Left" ? position.top_left : locationInput == "Bottom Right" ? position.bottom_right : locationInput == "Bottom Left" ? position.bottom_left : position.top_right
var table panel = table.new(panelPosition, columnCount, 13 + enabledCount, bgcolor = color.new(bgColor, transparency), frame_color = neutralColor, frame_width = 1, border_width = 0)
if barstate.isfirst and columnCount > 1
    for row = 0 to 9
        table.merge_cells(panel, 0, row, columnCount - 1, row)
    table.merge_cells(panel, 0, 11 + enabledCount, columnCount - 1, 11 + enabledCount)
    table.merge_cells(panel, 0, 12 + enabledCount, columnCount - 1, 12 + enabledCount)
if barstate.islast
    if not showDashboard
        table.clear(panel, 0, 0, columnCount - 1, 12 + enabledCount)
    else
        f_cell(panel, 0, 0, syminfo.ticker + " | MTF BIAS / STRUCTURE / STRENGTH", bgColor, textColor)
        f_cell(panel, 0, 1, f_summaryText("Overall", overall), overall.valid > 0 ? f_biasColor(overall.bias) : bgColor, textColor)
        f_cell(panel, 0, 2, f_summaryText("Higher: M / W / D", higher), higher.valid > 0 ? f_biasColor(higher.bias) : bgColor, textColor)
        f_cell(panel, 0, 3, f_summaryText("Medium: 4H / 1H", medium), medium.valid > 0 ? f_biasColor(medium.bias) : bgColor, textColor)
        f_cell(panel, 0, 4, f_summaryText("Lower: 15M / 5M", lower), lower.valid > 0 ? f_biasColor(lower.bias) : bgColor, textColor)
        f_cell(panel, 0, 5, "Bull: " + str.tostring(overall.bulls) + " | Bear: " + str.tostring(overall.bears) + " | Neutral: " + str.tostring(overall.neutrals), bgColor, textColor)
        f_cell(panel, 0, 6, "Directional alignment: " + f_number(overall.alignment) + "% (weighted; neutral not agreement)", bgColor, textColor)
        f_cell(panel, 0, 7, "Chart: " + timeframe.period + " | Market: " + condition + (complete ? "" : " [PARTIAL DATA]"), bgColor, highlightColor)
        f_cell(panel, 0, 8, context + (warnConflict and conflict ? " | LTF / HTF CONFLICT" : ""), conflict ? neutralColor : bgColor, textColor)
        f_cell(panel, 0, 9, (confirmed ? "CONFIRMED" : "LIVE - CAN REPAINT") + " | Ready: " + str.tostring(overall.valid) + "/" + str.tostring(overall.enabled) + " | Hover TF for source close (UTC)", bgColor, confirmed ? mutedColor : highlightColor)
        array<string> headers = array.from("TF", "Bias", "EMA / slope", "Structure", "ADX", useRsi ? "RSI" : "RSI (off)", "Score", "Price / EMA", "Distance %", "ATR %")
        array<bool> columns = array.from(true, colBias, colEma, colStructure, colAdx, colRsi, colScore, colPrice, colDistance, colAtr)
        int column = 0
        for j = 0 to 9
            if array.get(columns, j)
                f_cell(panel, column, 10, array.get(headers, j), neutralColor, textColor)
                column += 1
        int row = 11
        bool hasLower = false
        for i = 0 to 6
            if array.get(enabled, i)
                Snapshot s = array.get(data, i)
                string tf = array.get(tfs, i)
                bool isLower = timeframe.in_seconds(tf) < chartSeconds
                bool isCurrent = not chartIsTicks and timeframe.in_seconds(tf) == chartSeconds
                hasLower := hasLower or isLower
                string tip = "Standard OHLC | " + (na(s.closedAt) ? "No source candle available" : "Source close UTC: " + str.format_time(s.closedAt, "yyyy-MM-dd HH:mm", "UTC")) + (s.ready ? "" : " | Insufficient EMA / ADX / RSI / pivot history")
                string emaText = s.ema == 1 ? "Bull" : s.ema == -1 ? "Bear" : "Mixed"
                emaText += s.slope == 1 ? " / +" : s.slope == -1 ? " / -" : " / flat"
                string structureText = not s.structureReady ? "Building" : (s.highKind == 1 ? "HH" : s.highKind == -1 ? "LH" : "EH") + "/" + (s.lowKind == 1 ? "HL" : s.lowKind == -1 ? "LL" : "EL") + (s.structure == 0 ? " mixed" : "")
                float distanceFast = not na(s.fast) and s.fast != 0 ? 100 * (s.price - s.fast) / s.fast : na
                float distanceMid = not na(s.middle) and s.middle != 0 ? 100 * (s.price - s.middle) / s.middle : na
                float atrPercent = not na(s.price) and s.price != 0 ? 100 * s.atr / s.price : na
                string priceText = na(s.price) or na(s.slow) ? "N/A" : s.price > s.slow ? "Above" : s.price < s.slow ? "Below" : "At"
                array<string> values = array.from(array.get(names, i) + (isLower ? "*" : "") + (isCurrent ? " <" : ""), s.ready ? f_biasText(s.bias) : "N/A", na(s.fast) ? "N/A" : emaText, structureText, f_number(s.adx), f_number(s.rsi), f_signed(s.score), priceText, "F " + f_signed(distanceFast) + " / M " + f_signed(distanceMid), f_number(atrPercent))
                column := 0
                for j = 0 to 9
                    if array.get(columns, j)
                        color cellBg = j == 1 and s.ready ? f_biasColor(s.bias) : bgColor
                        f_cell(panel, column, row, array.get(values, j), cellBg, j == 0 and isCurrent ? highlightColor : textColor, tip)
                        column += 1
                row += 1
        string footer = hasLower ? (confirmed ? "* LTF: closed intrabar snapshot; transitions may be missed." : "* LTF: live sampled security value; can repaint.")
             : "HTF/equal: " + (confirmed ? "previous closed source candle." : "developing source candle.")
        f_cell(panel, 0, 11 + enabledCount, footer, bgColor, mutedColor)
        f_cell(panel, 0, 12 + enabledCount, chart.is_standard ? "BIAS IS NOT AN ENTRY | Alerts: chart close | No profit guarantee" : "Synthetic chart: dashboard = standard OHLC; overlays = chart OHLC", bgColor, mutedColor)
