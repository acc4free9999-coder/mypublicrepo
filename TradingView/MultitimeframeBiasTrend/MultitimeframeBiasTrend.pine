// Scalar fields in a UDT avoid the combined 127-tuple-element request limit.
type Snapshot
    float score = na
    int bias = 0
    int ema = 0
    int slope = 0
    int structure = 0
    int highKind = 0
    int lowKind = 0
    float adx = na
    float rsi = na
    float price = na
    float fast = na
    float middle = na
    float slow = na
    float atr = na
    float swingHigh = na
    float swingLow = na
    float pivotHigh = na
    float pivotLow = na
    int breakCode = 0
    int breakTime = na
    int closedAt = na
    bool structureReady = false
    bool ready = false
    bool trending = false
    bool ranging = false

type Summary
    float score = na
    int bias = 0
    int valid = 0
    int enabled = 0
    int bulls = 0
    int bears = 0
    int neutrals = 0
    float alignment = na
    float trendShare = na
    float rangeShare = na

type WaveEvent
    float price = na
    int kind = 0
    int stamp = na
    float minimum = na
    int closedAt = na

type WaveState
    array<float> prices
    array<int> times
    array<int> kinds
    array<line> lines
    array<label> labels
    int seen = na
    int recognizedAt = na
    string status = "N/A: no closed source data"

f_sign(float value) =>
    value > 0 ? 1 : value < 0 ? -1 : 0

f_class(float score, bool allowBull, bool allowBear, bool strongBull, bool strongBear) =>
    int result = 0
    if not na(score)
        if score >= biasMin and allowBull
            result := score >= strongMin and strongBull ? 2 : 1
        else if score <= -biasMin and allowBear
            result := score <= -strongMin and strongBear ? -2 : -1
    result

f_engine(simple int offset) =>
    float fast = ta.ema(close, fastLen)
    float middle = ta.ema(close, midLen)
    float slow = ta.ema(close, slowLen)
    float atr = ta.atr(atrLen)
    [diPlus, diMinus, adx] = ta.dmi(diLen, adxLen)
    float rsi = ta.rsi(close, rsiLen)
    float ph = ta.pivothigh(high, leftBars, rightBars)
    float pl = ta.pivotlow(low, leftBars, rightBars)
    var float hi = na
    var float previousHi = na
    var float lo = na
    var float previousLo = na
    var bool highBroken = false
    var bool lowBroken = false
    var int breakDirection = 0
    var int lastBreakCode = 0
    var int lastBreakTime = na
    // Breaks use levels already known before this candle, once per confirmed swing.
    if not na(hi) and not highBroken and close > hi
        lastBreakCode := breakDirection == -1 ? 2 : 1
        lastBreakTime := time
        breakDirection := 1
        highBroken := true
    else if not na(lo) and not lowBroken and close < lo
        lastBreakCode := breakDirection == 1 ? -2 : -1
        lastBreakTime := time
        breakDirection := -1
        lowBroken := true
    if not na(ph)
        previousHi := hi
        hi := ph
        highBroken := false
    if not na(pl)
        previousLo := lo
        lo := pl
        lowBroken := false
    bool structureReady = not na(previousHi) and not na(previousLo)
    int highKind = not na(previousHi) ? f_sign(hi - previousHi) : 0
    int lowKind = not na(previousLo) ? f_sign(lo - previousLo) : 0
    int structure = highKind == 1 and lowKind == 1 and close >= lo ? 1 : highKind == -1 and lowKind == -1 and close <= hi ? -1 : 0
    int ema = fast > middle and middle > slow ? 1 : fast < middle and middle < slow ? -1 : 0
    float slopeScale = atr * slopeBars
    float sf = slopeScale > 0 ? (fast - fast[slopeBars]) / slopeScale : na
    float sm = slopeScale > 0 ? (middle - middle[slopeBars]) / slopeScale : na
    float ss = slopeScale > 0 ? (slow - slow[slopeBars]) / slopeScale : na
    int slope = sf > slopeMin and sm > slopeMin and ss > slopeMin ? 1 : sf < -slopeMin and sm < -slopeMin and ss < -slopeMin ? -1 : 0
    int momentum = rsi > 50 + rsiBand ? 1 : rsi < 50 - rsiBand ? -1 : 0
    float denominator = wEma + wSlope + wStructure + (useRsi ? wRsi : 0)
    var int barsSeen = 0
    barsSeen += 1
    bool ready = barsSeen >= slowLen + slopeBars and not na(sf) and not na(sm) and not na(ss) and not na(adx) and (not useRsi or not na(rsi)) and (wStructure == 0 or structureReady)
    float raw = wEma * ema + wSlope * slope + wStructure * structure + (useRsi ? wRsi * momentum : 0)
    float score = ready and denominator > 0 ? math.max(-100, math.min(100, 100 * raw / denominator)) : na
    bool allowBull = (not useRsi or momentum == 1) and (not priceFilter or close > slow)
    bool allowBear = (not useRsi or momentum == -1) and (not priceFilter or close < slow)
    bool strongBull = adx >= adxMin and ema == 1 and slope == 1 and structure == 1
    bool strongBear = adx >= adxMin and ema == -1 and slope == -1 and structure == -1
    int bias = f_class(score, allowBull, allowBear, strongBull, strongBear)
    bool trending = ready and adx >= adxMin and structure != 0 and ema == structure
    bool ranging = ready and adx < adxMin and structure == 0
    Snapshot.new(score[offset], bias[offset], ema[offset], slope[offset], structure[offset], highKind[offset], lowKind[offset], adx[offset], rsi[offset], close[offset], fast[offset], middle[offset], slow[offset], atr[offset], hi[offset], lo[offset], ph[offset], pl[offset], lastBreakCode[offset], lastBreakTime[offset], time_close[offset], structureReady[offset], ready[offset], trending[offset], ranging[offset])

// Transfer primitives, not an object for every intrabar. Only the selected row is reconstructed.
f_intrabarValues() =>
    Snapshot s = f_engine(0)
    int flags = (s.ready ? 1 : 0) + (s.structureReady ? 2 : 0) + (s.trending ? 4 : 0) + (s.ranging ? 8 : 0)
    int directions = s.bias + 2 + 5 * (s.ema + 1) + 15 * (s.slope + 1) + 45 * (s.structure + 1) + 135 * (s.highKind + 1) + 405 * (s.lowKind + 1)
    [s.score, directions, s.adx, s.rsi, s.price, s.fast, s.middle, s.slow, s.atr, s.closedAt, flags]

string sourceTicker = ticker.standard(syminfo.tickerid)
bool chartIsTicks = str.endswith(timeframe.period, "T")
int chartSeconds = chartIsTicks ? 0 : timeframe.in_seconds()
f_fetch(simple string tf, simple bool enabled) =>
    Snapshot result = Snapshot.new()
    var Snapshot lastClosedIntrabar = Snapshot.new()
    if enabled
        bool lower = timeframe.in_seconds(tf) < chartSeconds
        if confirmed and lower
            [scores, directions, adxs, rsis, prices, fasts, middles, slows, atrs, closes, states] = request.security_lower_tf(sourceTicker, tf, f_intrabarValues(), calc_bars_count = intrabarBars)
            result := lastClosedIntrabar
            int index = array.size(closes) - 1
            int closedThrough = na(time_close) ? timenow : math.min(timenow, time_close)
            // A new chart candle can have no closed intrabars yet; retain only a known closed source.
            while index >= 0
                int sourceClose = array.get(closes, index)
                if not na(sourceClose) and sourceClose <= closedThrough
                    int flags = array.get(states, index)
                    int code = array.get(directions, index)
                    result := Snapshot.new(score = array.get(scores, index), bias = code % 5 - 2, ema = int(code / 5) % 3 - 1, slope = int(code / 15) % 3 - 1, structure = int(code / 45) % 3 - 1, highKind = int(code / 135) % 3 - 1, lowKind = int(code / 405) % 3 - 1, adx = array.get(adxs, index), rsi = array.get(rsis, index), price = array.get(prices, index), fast = array.get(fasts, index), middle = array.get(middles, index), slow = array.get(slows, index), atr = array.get(atrs, index), closedAt = sourceClose, ready = flags % 2 == 1, structureReady = int(flags / 2) % 2 == 1, trending = int(flags / 4) % 2 == 1, ranging = int(flags / 8) % 2 == 1)
                    lastClosedIntrabar := result
                    break
                index -= 1
        else
            // lookahead_on is ONLY used with offset=1, never with live/unshifted data.
            result := request.security(sourceTicker, tf, f_engine(confirmed ? 1 : 0), gaps = barmerge.gaps_off, lookahead = confirmed and not lower ? barmerge.lookahead_on : barmerge.lookahead_off, calc_bars_count = sourceBars)
    if na(result)
        result := Snapshot.new()
    result

f_summary(array<Snapshot> data, array<bool> enabled, array<float> weights, int first, int last) =>
    Summary result = Summary.new()
    float total = 0
    float weightedScore = 0
    float bullWeight = 0
    float bearWeight = 0
    float strongBullWeight = 0
    float strongBearWeight = 0
    float trendWeight = 0
    float rangeWeight = 0
    for i = first to last
        if array.get(enabled, i)
            result.enabled += 1
            Snapshot s = array.get(data, i)
            if s.ready
                float weight = array.get(weights, i)
                result.valid += 1
                total += weight
                // A direction veto contributes zero, but retains its denominator weight.
                weightedScore += weight * (s.bias == 0 ? 0 : s.score)
                if s.bias > 0
                    result.bulls += 1
                    bullWeight += weight
                else if s.bias < 0
                    result.bears += 1
                    bearWeight += weight
                else
                    result.neutrals += 1
                strongBullWeight += s.bias == 2 ? weight : 0
                strongBearWeight += s.bias == -2 ? weight : 0
                trendWeight += s.trending ? weight : 0
                rangeWeight += s.ranging ? weight : 0
    if total > 0
        result.score := weightedScore / total
        result.bias := f_class(result.score, true, true, 100 * strongBullWeight / total >= consensus, 100 * strongBearWeight / total >= consensus)
        result.alignment := 100 * math.max(bullWeight, bearWeight) / total
        result.trendShare := 100 * trendWeight / total
        result.rangeShare := 100 * rangeWeight / total
    result

f_biasText(int bias) =>
    switch bias
        2 => "Strong Bullish"
        1 => "Bullish"
        -1 => "Bearish"
        -2 => "Strong Bearish"
        => "Neutral / Range"

f_biasColor(int bias) =>
    switch bias
        2 => strongBullColor
        1 => bullColor
        -1 => bearColor
        -2 => strongBearColor
        => neutralColor

f_number(float value) =>
    na(value) ? "N/A" : str.tostring(value, "#.0")

f_signed(float value) =>
    na(value) ? "N/A" : (value > 0 ? "+" : "") + str.tostring(value, "#.0")

f_summaryText(string title, Summary s) =>
    title + ": " + (s.valid == 0 ? "N/A" : f_biasText(s.bias) + " [" + f_signed(s.score) + "]") + "  (" + str.tostring(s.valid) + "/" + str.tostring(s.enabled) + ")"

f_cell(table panel, int column, int row, string value, color background, color foreground, string tip = "") =>
    string font = textSize == "Tiny" ? size.tiny : textSize == "Normal" ? size.normal : textSize == "Large" ? size.large : size.small
    table.cell(panel, column, row, value, text_color = foreground, bgcolor = color.new(background, transparency), text_size = font, tooltip = tip)

f_addLabel(array<label> labels, string value, float price, bool above, color background) =>
    label item = label.new(bar_index, price, value, style = above ? label.style_label_down : label.style_label_up, color = background, textcolor = textColor, size = size.tiny)
    array.push(labels, item)
    if array.size(labels) > labelLimit
        label.delete(array.shift(labels))

f_ewCorrection(array<float> points, int start) =>
    float p0 = array.get(points, start)
    int direction = f_sign(array.get(points, start + 1) - p0)
    float a = direction * (array.get(points, start + 1) - p0)
    float b = direction * (array.get(points, start + 2) - p0)
    float c = direction * (array.get(points, start + 3) - p0)
    float retrace = a > 0 ? (a - b) / a : na
    float tolerance = a * ewEquality
    string kind = ""
    if a > 0 and retrace > 0
        if retrace < 0.9 and b > 0 and c > a
            kind := "Zigzag"
        else if retrace >= 0.9 and retrace <= 1.1 and math.abs(c - a) <= tolerance
            kind := "Regular flat"
        else if retrace > 1.0 and c > a + tolerance
            kind := "Expanded flat"
        else if retrace > 1.0 and c > b and c < a - tolerance
            kind := "Running flat"
    kind

f_ewMotive(array<float> points, int start, bool diagonal) =>
    float origin = array.get(points, start)
    int direction = f_sign(array.get(points, start + 1) - origin)
    float p1 = direction * (array.get(points, start + 1) - origin)
    float p2 = direction * (array.get(points, start + 2) - origin)
    float p3 = direction * (array.get(points, start + 3) - origin)
    float p4 = direction * (array.get(points, start + 4) - origin)
    float p5 = direction * (array.get(points, start + 5) - origin)
    float w1 = p1
    float w3 = p3 - p2
    float w5 = p5 - p4
    bool base = p1 > 0 and p2 > 0 and p2 < p1 and p3 > p1 and p4 > p2 and p4 < p3 and p5 > p4
    string kind = ""
    if base
        if not diagonal and p4 > p1 and w3 >= math.min(w1, w5)
            if p5 <= p3
                kind := "Impulse: truncated 5"
            else if w3 > 1.618 * math.max(w1, w5)
                kind := "Impulse: extended 3"
            else if w1 > 1.618 * math.max(w3, w5)
                kind := "Impulse: extended 1"
            else if w5 > 1.618 * math.max(w1, w3)
                kind := "Impulse: extended 5"
            else
                kind := "Impulse"
        else if diagonal and p4 < p1 and p5 > p3
            float w2 = p1 - p2
            float w4 = p3 - p4
            if w1 > w3 and w3 > w5 and w2 > w4
                kind := "Contracting diagonal"
            else if w1 < w3 and w3 < w5 and w2 < w4
                kind := "Expanding diagonal"
    kind

f_ewTriangle(array<float> points, int start) =>
    float origin = array.get(points, start)
    int direction = f_sign(array.get(points, start + 1) - origin)
    float a = direction * (array.get(points, start + 1) - origin)
    float b = direction * (array.get(points, start + 2) - origin)
    float c = direction * (array.get(points, start + 3) - origin)
    float d = direction * (array.get(points, start + 4) - origin)
    float e = direction * (array.get(points, start + 5) - origin)
    float tolerance = a * ewEquality
    bool alternating = a > 0 and b < a and c > b and d < c and e > d
    string kind = ""
    if alternating
        if b > 0 and c < a - tolerance and d > b + tolerance and e < c
            kind := "Contracting triangle"
        else if b > 0 and math.abs(c - a) <= tolerance and d > b + tolerance and e <= c + tolerance
            kind := "Barrier triangle"
        else if b > 0 and c < a - tolerance and math.abs(d - b) <= tolerance and e < c
            kind := "Barrier triangle"
        else if c > a + tolerance and d < b - tolerance and e > c
            kind := "Expanding triangle"
    kind

f_ewCombination(array<float> points, int start, int components) =>
    bool valid = true
    for component = 0 to components - 1
        if f_ewCorrection(points, start + component * 3) == ""
            valid := false
    valid

f_ewPivot(array<float> prices, array<int> times, array<int> kinds, float price, int stamp, int kind, float minimum) =>
    bool changed = false
    int count = array.size(prices)
    if count == 0
        array.push(prices, price)
        array.push(times, stamp)
        array.push(kinds, kind)
        changed := true
    else
        float last = array.get(prices, count - 1)
        if stamp > array.get(times, count - 1)
            if kind == array.get(kinds, count - 1)
                if kind * (price - last) > 0
                    array.set(prices, count - 1, price)
                    array.set(times, count - 1, stamp)
                    changed := true
            else if not na(minimum) and kind * (price - last) >= minimum and kind * (price - last) > 0
                array.push(prices, price)
                array.push(times, stamp)
                array.push(kinds, kind)
                if array.size(prices) > 32
                    array.shift(prices)
                    array.shift(times)
                    array.shift(kinds)
                changed := true
    changed

f_ewColor(string tfName, bool motive) =>
    color shade = motive ? ewMotiveColor : ewCorrectionColor
    if ewColorByTf
        shade := switch tfName
            "1M" => ewColorM
            "1W" => ewColorW
            "1D" => ewColorD
            "4H" => ewColor4H
            "1H" => ewColor1H
            "15M" => ewColor15
            "5M" => ewColor5
    shade

f_ewDraw(array<float> points, array<int> times, int start, int legs, string kind, string notation, array<line> lines, array<label> labels, string tfName, int recognizedAt) =>
    color shade = f_ewColor(tfName, notation == "12345")
    int direction = f_sign(array.get(points, start + 1) - array.get(points, start))
    string confirmedAt = str.format_time(recognizedAt, "yyyy-MM-dd HH:mm", "UTC")
    for i = 0 to legs
        string wave = i == 0 ? "0" : ""
        if i > 0
            if notation == "12345"
                wave := str.tostring(i)
            else if notation == "ABCDE"
                wave := str.substring("ABCDE", i - 1, i)
            else if notation == "ABC"
                wave := str.substring("ABC", i - 1, i)
            else
                int component = int((i - 1) / 3)
                wave := str.substring(notation, component, component + 1) + "." + str.substring("ABC", (i - 1) % 3, (i - 1) % 3 + 1)
        float price = array.get(points, start + i)
        bool above = i % 2 == 1 ? direction > 0 : direction < 0
        label marker = label.new(array.get(times, start + i), price, tfName + " " + wave, xloc = xloc.bar_time, style = above ? label.style_label_down : label.style_label_up, color = color.new(shade, 25), textcolor = textColor, size = size.tiny, tooltip = tfName + " " + kind + " candidate\nSource confirmed UTC: " + confirmedAt + "\nBack-positioned pivot label; not known on the pivot candle.")
        array.push(labels, marker)
        if i > 0
            array.push(lines, line.new(array.get(times, start + i - 1), array.get(points, start + i - 1), array.get(times, start + i), price, xloc = xloc.bar_time, color = shade, width = 2))
    array.push(labels, label.new(recognizedAt, array.get(points, start + legs), tfName + " " + kind + " candidate\nSource confirmed here; not an entry", xloc = xloc.bar_time, style = direction > 0 ? label.style_label_down : label.style_label_up, color = shade, textcolor = textColor, size = size.tiny))

f_ewEvent(simple int offset) =>
    float ph = ta.pivothigh(high, ewLeft, ewRight)
    float pl = ta.pivotlow(low, ewLeft, ewRight)
    float minimum = ta.atr(atrLen) * ewMinAtr
    int kind = not na(ph) and na(pl) ? 1 : not na(pl) and na(ph) ? -1 : 0
    float price = kind == 1 ? ph : kind == -1 ? pl : na
    WaveEvent.new(price[offset], kind[offset], time[ewRight + offset], minimum[offset], time_close[offset])

f_ewValues() =>
    WaveEvent event = f_ewEvent(0)
    [event.price, event.kind, event.stamp, event.minimum, event.closedAt]

f_ewAccept(WaveState state, float price, int stamp, int kind, float minimum, int closedAt) =>
    if not na(closedAt) and (na(state.seen) or closedAt > state.seen)
        state.seen := closedAt
        if kind != 0 and not na(price) and not na(stamp)
            if f_ewPivot(state.prices, state.times, state.kinds, price, stamp, kind, minimum)
                state.recognizedAt := closedAt
        state.status := array.size(state.prices) < 4 ? "Building pivots" : "No matching candidate"
    true

f_ewFetch(string tf, WaveState state) =>
    bool lowerTf = timeframe.in_seconds(tf) < chartSeconds
    if lowerTf
        [prices, kinds, stamps, minimums, closes] = request.security_lower_tf(sourceTicker, tf, f_ewValues(), calc_bars_count = ewHistory)
        if barstate.isconfirmed
            int cutoff = na(time_close) ? timenow : math.min(time_close, timenow)
            int count = array.size(closes)
            if count > 0
                for i = 0 to count - 1
                    int closedAt = array.get(closes, i)
                    if not na(closedAt) and closedAt <= cutoff
                        f_ewAccept(state, array.get(prices, i), array.get(stamps, i), array.get(kinds, i), array.get(minimums, i), closedAt)
    else
        WaveEvent event = request.security(sourceTicker, tf, f_ewEvent(1), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on, calc_bars_count = ewHistory)
        if barstate.isconfirmed and not na(event)
            f_ewAccept(state, event.price, event.stamp, event.kind, event.minimum, event.closedAt)
    true

array<bool> enabled = array.from(onM, onW, onD, on4H, on1H, on15, on5)
array<float> weights = array.from(wtM, wtW, wtD, wt4H, wt1H, wt15, wt5)
array<string> tfs = array.from("1M", "1W", "1D", "240", "60", "15", "5")
array<string> names = array.from("1M", "1W", "1D", "4H", "1H", "15M", "5M")
int enabledCount = (onM ? 1 : 0) + (onW ? 1 : 0) + (onD ? 1 : 0) + (on4H ? 1 : 0) + (on1H ? 1 : 0) + (on15 ? 1 : 0) + (on5 ? 1 : 0)
if barstate.isfirst
    if fastLen >= midLen or midLen >= slowLen
        runtime.error("EMA lengths must satisfy fast < middle < slow.")
    if strongMin <= biasMin
        runtime.error("Strong score threshold must exceed the directional threshold.")
    if wEma + wSlope + wStructure + (useRsi ? wRsi : 0) <= 0
        runtime.error("At least one active scoring weight must be positive.")
    if enabledCount == 0
        runtime.error("Enable at least one timeframe.")

Snapshot m = f_fetch("1M", onM)
Snapshot w = f_fetch("1W", onW)
Snapshot d = f_fetch("1D", onD)
Snapshot h4 = f_fetch("240", on4H)
Snapshot h1 = f_fetch("60", on1H)
Snapshot m15 = f_fetch("15", on15)
Snapshot m5 = f_fetch("5", on5)
array<Snapshot> data = array.from(m, w, d, h4, h1, m15, m5)
Summary overall = f_summary(data, enabled, weights, 0, 6)
Summary higher = f_summary(data, enabled, weights, 0, 2)
Summary medium = f_summary(data, enabled, weights, 3, 4)
Summary lower = f_summary(data, enabled, weights, 5, 6)
bool complete = overall.valid == overall.enabled and overall.valid > 0
bool higherComplete = higher.valid == higher.enabled and higher.valid >= 2
int htfAlignment = higherComplete and higher.bulls == higher.valid ? 1 : higherComplete and higher.bears == higher.valid ? -1 : 0
int lowerDirection = f_sign(lower.bias)
bool conflict = htfAlignment != 0 and lower.valid == lower.enabled and lower.valid > 0 and lowerDirection == -htfAlignment
string condition = overall.valid == 0 ? "N/A" : overall.trendShare >= consensus ? "Trending" : overall.rangeShare >= consensus ? "Ranging" : "Mixed"
string context = "WAIT / MIXED"
if complete and higherComplete
    if condition == "Ranging"
        context := "RANGE"
    else if conflict
        context := "PULLBACK WATCH"
    else if htfAlignment == 1 and overall.bias > 0 and medium.bias >= 0 and lower.bias >= 0
        context := "BUY BIAS"
    else if htfAlignment == -1 and overall.bias < 0 and medium.bias <= 0 and lower.bias <= 0
        context := "SELL BIAS"
else if complete and condition == "Ranging"
    context := "RANGE"

var array<WaveState> ewStates = array.new<WaveState>()
array<bool> ewTimeframes = array.from(ewOnM, ewOnW, ewOnD, ewOn4H, ewOn1H, ewOn15, ewOn5)
if barstate.isfirst
    for i = 0 to 6
        array.push(ewStates, WaveState.new(array.new<float>(), array.new<int>(), array.new<int>(), array.new<line>(), array.new<label>()))
string ewStatus = ""
if ewEnabled
    for tfIndex = 0 to 6
        if array.get(ewTimeframes, tfIndex)
            WaveState state = array.get(ewStates, tfIndex)
            f_ewFetch(array.get(tfs, tfIndex), state)
            if barstate.islast
                while array.size(state.lines) > 0
                    line.delete(array.pop(state.lines))
                while array.size(state.labels) > 0
                    label.delete(array.pop(state.labels))
                state.status := na(state.seen) ? "N/A: no closed source data" : array.size(state.prices) < 4 ? "Building pivots" : "No matching candidate"
                int count = array.size(state.prices)
                string matches = ""
                for family = 0 to 4
                    string kind = ""
                    string notation = ""
                    int legs = family == 1 ? 3 : family == 4 ? 9 : 5
                    if family == 0 and ewImpulse and count >= 6
                        kind := f_ewMotive(state.prices, count - 6, false)
                        notation := "12345"
                    else if family == 1 and ewAbc and count >= 4
                        kind := f_ewCorrection(state.prices, count - 4)
                        notation := "ABC"
                    else if family == 2 and ewDiagonal and count >= 6
                        kind := f_ewMotive(state.prices, count - 6, true)
                        notation := "12345"
                    else if family == 3 and ewTriangle and count >= 6
                        kind := f_ewTriangle(state.prices, count - 6)
                        notation := "ABCDE"
                    else if family == 4 and ewCombination
                        if count >= 16 and f_ewCombination(state.prices, count - 16, 5)
                            kind := "WXYXZ combination"
                            notation := "WXYXZ"
                            legs := 15
                        else if count >= 10 and f_ewCombination(state.prices, count - 10, 3)
                            kind := "WXY combination"
                            notation := "WXY"
                    if kind != ""
                        f_ewDraw(state.prices, state.times, count - legs - 1, legs, kind, notation, state.lines, state.labels, array.get(names, tfIndex), state.recognizedAt)
                        matches := matches == "" ? kind : matches + " / " + kind
                if matches != ""
                    state.status := matches
                ewStatus += (ewStatus == "" ? "" : "\n") + array.get(names, tfIndex) + ": " + state.status
    if ewStatus == ""
        ewStatus := "All Elliott timeframes disabled"

var array<box> sdBoxes = array.new<box>()
var array<int> sdDirs = array.new<int>()
var array<float> sdTops = array.new<float>()
var array<float> sdBottoms = array.new<float>()
var array<int> sdTests = array.new<int>()
bool sdTestedDemand = false
bool sdTestedSupply = false
float sdAtr = ta.atr(atrLen)
float sdLimit = sdBaseAtr * sdAtr
bool sdSmall1 = math.abs(close[1] - open[1]) <= sdLimit
bool sdSmall2 = sdSmall1 and math.abs(close[2] - open[2]) <= sdLimit
bool sdSmall3 = sdSmall2 and math.abs(close[3] - open[3]) <= sdLimit
int sdBase = sdSmall3 and sdMaxBase >= 3 ? 3 : sdSmall2 and sdMaxBase >= 2 ? 2 : sdSmall1 ? 1 : 0
float sdBaseHigh = sdBase == 3 ? math.max(high[1], high[2], high[3]) : sdBase == 2 ? math.max(high[1], high[2]) : high[1]
float sdBaseLow = sdBase == 3 ? math.min(low[1], low[2], low[3]) : sdBase == 2 ? math.min(low[1], low[2]) : low[1]
float sdBodyHigh = sdBase == 3 ? math.max(math.max(open[1], close[1]), math.max(open[2], close[2]), math.max(open[3], close[3])) : sdBase == 2 ? math.max(math.max(open[1], close[1]), math.max(open[2], close[2])) : math.max(open[1], close[1])
float sdBodyLow = sdBase == 3 ? math.min(math.min(open[1], close[1]), math.min(open[2], close[2]), math.min(open[3], close[3])) : sdBase == 2 ? math.min(math.min(open[1], close[1]), math.min(open[2], close[2])) : math.min(open[1], close[1])
if sdEnabled and barstate.isconfirmed
    int total = array.size(sdBoxes)
    if total > 0
        for i = total - 1 to 0
            int dir = array.get(sdDirs, i)
            float top = array.get(sdTops, i)
            float bottom = array.get(sdBottoms, i)
            bool broken = dir == 1 ? close < bottom : close > top
            if broken
                box.delete(array.get(sdBoxes, i))
                array.remove(sdBoxes, i)
                array.remove(sdDirs, i)
                array.remove(sdTops, i)
                array.remove(sdBottoms, i)
                array.remove(sdTests, i)
            else if (dir == 1 and low <= top) or (dir == -1 and high >= bottom)
                array.set(sdTests, i, array.get(sdTests, i) + 1)
                sdTestedDemand := sdTestedDemand or dir == 1
                sdTestedSupply := sdTestedSupply or dir == -1
                if sdText
                    box.set_text(array.get(sdBoxes, i), (dir == 1 ? "D" : "S") + " x" + str.tostring(array.get(sdTests, i)))
    // Creation runs after mitigation, so the displacement candle cannot test its own new zone.
    float body = math.abs(close - open)
    int newDir = sdBase > 0 and not na(sdAtr) and body >= sdImpulseAtr * sdAtr ? (close > open and close > sdBaseHigh and sdDemand ? 1 : close < open and close < sdBaseLow and sdSupply ? -1 : 0) : 0
    if newDir != 0
        float zoneTop = newDir == 1 ? sdBodyHigh : (sdWicks ? sdBaseHigh : sdBodyHigh)
        float zoneBottom = newDir == 1 ? (sdWicks ? sdBaseLow : sdBodyLow) : sdBodyLow
        bool overlaps = false
        int zoneCount = array.size(sdBoxes)
        // Pine loops count downward when the end is below the start, so guard empty arrays.
        if zoneCount > 0
            for i = 0 to zoneCount - 1
                if array.get(sdDirs, i) == newDir and zoneTop >= array.get(sdBottoms, i) and zoneBottom <= array.get(sdTops, i)
                    overlaps := true
        if not overlaps and zoneTop > zoneBottom
            color zoneColor = newDir == 1 ? sdDemandColor : sdSupplyColor
            array.push(sdBoxes, box.new(bar_index - sdBase, zoneTop, bar_index, zoneBottom, border_color = zoneColor, bgcolor = color.new(zoneColor, sdOpacity), extend = extend.right, text = sdText ? (newDir == 1 ? "D" : "S") : "", text_color = textColor, text_size = size.tiny, text_halign = text.align_right))
            array.push(sdDirs, newDir)
            array.push(sdTops, zoneTop)
            array.push(sdBottoms, zoneBottom)
            array.push(sdTests, 0)
            if array.size(sdBoxes) > sdMaxZones
                box.delete(array.shift(sdBoxes))
                array.shift(sdDirs)
                array.shift(sdTops)
                array.shift(sdBottoms)
                array.shift(sdTests)

// Optional overlays use chart OHLC, not requested source OHLC on synthetic charts.
Snapshot chartData = f_engine(0)
Snapshot chartClosed = barstate.isconfirmed ? chartData : chartData[1]
plot(showSlow and not na(chartClosed) ? chartClosed.slow : na, "Chart slow EMA", color = color.orange, linewidth = 2)
plot(showSwings and not na(chartClosed) ? chartClosed.swingHigh : na, "Confirmed swing high", color = bearColor, style = plot.style_stepline)
plot(showSwings and not na(chartClosed) ? chartClosed.swingLow : na, "Confirmed swing low", color = bullColor, style = plot.style_stepline)
var array<label> chartLabels = array.new<label>()
bool chartBreak = barstate.isconfirmed and chartData.breakTime == time
if barstate.isconfirmed
    if showStructureLabels and not na(chartData.pivotHigh)
        string highText = chartData.highKind == 1 ? "HH" : chartData.highKind == -1 ? "LH" : "SH / Equal"
        f_addLabel(chartLabels, highText + " confirmed", high, true, neutralColor)
    if showStructureLabels and not na(chartData.pivotLow)
        string lowText = chartData.lowKind == 1 ? "HL" : chartData.lowKind == -1 ? "LL" : "SL / Equal"
        f_addLabel(chartLabels, lowText + " confirmed", low, false, neutralColor)
    if showBreaks and chartBreak
        string breakText = math.abs(chartData.breakCode) == 2 ? "CHoCH" : "BOS"
        f_addLabel(chartLabels, breakText + (chartData.breakCode > 0 ? " UP" : " DOWN"), chartData.breakCode > 0 ? low : high, chartData.breakCode < 0, chartData.breakCode > 0 ? bullColor : bearColor)

var int lastDirection = 0
var int priorHtfAlignment = 0
var bool priorPullback = false
var string lastRegime = ""
bool flipBull = false
bool flipBear = false
bool newHtfBull = false
bool newHtfBear = false
bool newPullback = false
bool newTrend = false
if barstate.isconfirmed
    if complete
        int direction = f_sign(overall.bias)
        flipBull := direction == 1 and lastDirection == -1
        flipBear := direction == -1 and lastDirection == 1
        if direction != 0
            lastDirection := direction
        newHtfBull := htfAlignment == 1 and priorHtfAlignment != 1
        newHtfBear := htfAlignment == -1 and priorHtfAlignment != -1
        newPullback := conflict and not priorPullback
        newTrend := condition == "Trending" and lastRegime == "Ranging"
        if condition != "Mixed"
            lastRegime := condition
        priorHtfAlignment := htfAlignment
        priorPullback := conflict
    else
        lastDirection := 0
        priorHtfAlignment := 0
        priorPullback := false
        lastRegime := ""

alertcondition(alertFlip and flipBull, "Overall turns bullish", "{{ticker}}: overall bias reversed bullish at chart close. Directional context, not an entry.")
alertcondition(alertFlip and flipBear, "Overall turns bearish", "{{ticker}}: overall bias reversed bearish at chart close. Directional context, not an entry.")
alertcondition(alertHtf and newHtfBull, "HTF bullish alignment", "{{ticker}}: enabled higher timeframes aligned bullish at chart close.")
alertcondition(alertHtf and newHtfBear, "HTF bearish alignment", "{{ticker}}: enabled higher timeframes aligned bearish at chart close.")
alertcondition(alertPullback and newPullback, "LTF pullback against HTF", "{{ticker}}: lower-timeframe bias opposes higher-timeframe alignment. Pullback watch, not an entry.")
alertcondition(alertTrend and newTrend, "Ranging to trending", "{{ticker}}: weighted market condition changed from ranging to trending, allowing an intervening mixed phase.")
alertcondition(alertStructure and chartBreak and chartData.breakCode > 0, "Chart bullish structure break", "{{ticker}} {{interval}}: candle closed above an unbroken confirmed swing high (BOS or CHoCH).")
alertcondition(sdEnabled and sdTestedDemand, "Price tests demand zone", "{{ticker}} {{interval}}: candle closed after trading into an active demand zone. Context, not an entry.")
alertcondition(sdEnabled and sdTestedSupply, "Price tests supply zone", "{{ticker}} {{interval}}: candle closed after trading into an active supply zone. Context, not an entry.")
alertcondition(alertStructure and chartBreak and chartData.breakCode < 0, "Chart bearish structure break", "{{ticker}} {{interval}}: candle closed below an unbroken confirmed swing low (BOS or CHoCH).")

int columnCount = 1 + (colBias ? 1 : 0) + (colEma ? 1 : 0) + (colStructure ? 1 : 0) + (colAdx ? 1 : 0) + (colRsi ? 1 : 0) + (colScore ? 1 : 0) + (colPrice ? 1 : 0) + (colDistance ? 1 : 0) + (colAtr ? 1 : 0)
string panelPosition = locationInput == "Top Left" ? position.top_left : locationInput == "Bottom Right" ? position.bottom_right : locationInput == "Bottom Left" ? position.bottom_left : position.top_right
var table panel = table.new(panelPosition, columnCount, 13 + enabledCount, bgcolor = color.new(bgColor, transparency), frame_color = neutralColor, frame_width = 1, border_width = 0)
if barstate.isfirst and columnCount > 1
    for row = 0 to 9
        table.merge_cells(panel, 0, row, columnCount - 1, row)
    table.merge_cells(panel, 0, 11 + enabledCount, columnCount - 1, 11 + enabledCount)
    table.merge_cells(panel, 0, 12 + enabledCount, columnCount - 1, 12 + enabledCount)
if barstate.islast
    if not showDashboard
        table.clear(panel, 0, 0, columnCount - 1, 12 + enabledCount)
    else
        f_cell(panel, 0, 0, syminfo.ticker + " | MTF BIAS / STRUCTURE / STRENGTH", bgColor, textColor)
        f_cell(panel, 0, 1, f_summaryText("Overall", overall), overall.valid > 0 ? f_biasColor(overall.bias) : bgColor, textColor)
        f_cell(panel, 0, 2, f_summaryText("Higher: M / W / D", higher), higher.valid > 0 ? f_biasColor(higher.bias) : bgColor, textColor)
        f_cell(panel, 0, 3, f_summaryText("Medium: 4H / 1H", medium), medium.valid > 0 ? f_biasColor(medium.bias) : bgColor, textColor)
        f_cell(panel, 0, 4, f_summaryText("Lower: 15M / 5M", lower), lower.valid > 0 ? f_biasColor(lower.bias) : bgColor, textColor)
        f_cell(panel, 0, 5, "Bull: " + str.tostring(overall.bulls) + " | Bear: " + str.tostring(overall.bears) + " | Neutral: " + str.tostring(overall.neutrals), bgColor, textColor)
        f_cell(panel, 0, 6, "Directional alignment: " + f_number(overall.alignment) + "% (weighted; neutral not agreement)", bgColor, textColor)
        f_cell(panel, 0, 7, "Chart: " + timeframe.period + " | Market: " + condition + (complete ? "" : " [PARTIAL DATA]"), bgColor, highlightColor)
        f_cell(panel, 0, 8, context + (warnConflict and conflict ? " | LTF / HTF CONFLICT" : "") + (ewEnabled ? "\nEW: " + ewStatus : ""), conflict ? neutralColor : bgColor, textColor)
        f_cell(panel, 0, 9, (confirmed ? "CONFIRMED" : "LIVE - CAN REPAINT") + " | Ready: " + str.tostring(overall.valid) + "/" + str.tostring(overall.enabled) + " | Hover TF for source close (UTC)", bgColor, confirmed ? mutedColor : highlightColor)
        array<string> headers = array.from("TF", "Bias", "EMA / slope", "Structure", "ADX", useRsi ? "RSI" : "RSI (off)", "Score", "Price / EMA", "Distance %", "ATR %")
        array<bool> columns = array.from(true, colBias, colEma, colStructure, colAdx, colRsi, colScore, colPrice, colDistance, colAtr)
        int column = 0
        for j = 0 to 9
            if array.get(columns, j)
                f_cell(panel, column, 10, array.get(headers, j), neutralColor, textColor)
                column += 1
        int row = 11
        bool hasLower = false
        for i = 0 to 6
            if array.get(enabled, i)
                Snapshot s = array.get(data, i)
                string tf = array.get(tfs, i)
                bool isLower = timeframe.in_seconds(tf) < chartSeconds
                bool isCurrent = not chartIsTicks and timeframe.in_seconds(tf) == chartSeconds
                hasLower := hasLower or isLower
                string tip = "Standard OHLC | " + (na(s.closedAt) ? "No source candle available" : "Source close UTC: " + str.format_time(s.closedAt, "yyyy-MM-dd HH:mm", "UTC")) + (s.ready ? "" : " | Insufficient EMA / ADX / RSI / pivot history")
                string emaText = s.ema == 1 ? "Bull" : s.ema == -1 ? "Bear" : "Mixed"
                emaText += s.slope == 1 ? " / +" : s.slope == -1 ? " / -" : " / flat"
                string structureText = not s.structureReady ? "Building" : (s.highKind == 1 ? "HH" : s.highKind == -1 ? "LH" : "EH") + "/" + (s.lowKind == 1 ? "HL" : s.lowKind == -1 ? "LL" : "EL") + (s.structure == 0 ? " mixed" : "")
                float distanceFast = not na(s.fast) and s.fast != 0 ? 100 * (s.price - s.fast) / s.fast : na
                float distanceMid = not na(s.middle) and s.middle != 0 ? 100 * (s.price - s.middle) / s.middle : na
                float atrPercent = not na(s.price) and s.price != 0 ? 100 * s.atr / s.price : na
                string priceText = na(s.price) or na(s.slow) ? "N/A" : s.price > s.slow ? "Above" : s.price < s.slow ? "Below" : "At"
                array<string> values = array.from(array.get(names, i) + (isLower ? "*" : "") + (isCurrent ? " <" : ""), s.ready ? f_biasText(s.bias) : "N/A", na(s.fast) ? "N/A" : emaText, structureText, f_number(s.adx), f_number(s.rsi), f_signed(s.score), priceText, "F " + f_signed(distanceFast) + " / M " + f_signed(distanceMid), f_number(atrPercent))
                column := 0
                for j = 0 to 9
                    if array.get(columns, j)
                        color cellBg = j == 1 and s.ready ? f_biasColor(s.bias) : bgColor
                        f_cell(panel, column, row, array.get(values, j), cellBg, j == 0 and isCurrent ? highlightColor : textColor, tip)
                        column += 1
                row += 1
        string footer = hasLower ? (confirmed ? "* LTF: closed intrabar snapshot; transitions may be missed." : "* LTF: live sampled security value; can repaint.")
             : "HTF/equal: " + (confirmed ? "previous closed source candle." : "developing source candle.")
        f_cell(panel, 0, 11 + enabledCount, footer, bgColor, mutedColor)
        f_cell(panel, 0, 12 + enabledCount, chart.is_standard ? "BIAS IS NOT AN ENTRY | Alerts: chart close | No profit guarantee" : "Synthetic chart: dashboard = standard OHLC; overlays = chart OHLC", bgColor, mutedColor)
