string G_LS = "Liquidity sweeps (chart timeframe)"
bool lsEnabled = input.bool(true, "Show liquidity sweeps", group = G_LS, tooltip = "Adapted from Liquidity Sweeps by LuxAlgo (CC BY-NC-SA 4.0). A swing high/low is a liquidity pool; a sweep is price taking it out and reversing. Wick sweep: the wick pierces the swing level but the candle closes back on the other side. Outbreak and retest: price closes through the level, then later wicks back through it and closes on the original side. Sweeps are a context marker, not an entry signal.")
int lsLen = input.int(5, "Sweep swing length", minval = 1, maxval = 50, group = G_LS, tooltip = "Bars on each side that confirm a swing (confirmation delay = this many bars).")
