//@version=6
indicator("Structure & Chart Tools", "Structure Tools", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

max_bars_back(time, 5000)
max_bars_back(high, 5000)
max_bars_back(low, 5000)
max_bars_back(close, 5000)
max_bars_back(open, 5000)

